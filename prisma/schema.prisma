// ─────────────────────────────────────────────
// EMPRESA (tenant raiz)
// ─────────────────────────────────────────────

model Empresa {
  id                   String   @id @default(cuid())
  nome                 String
  nomeFantasia         String?
  cnpj                 String   @unique
  email                String
  telefone             String?
  celular              String?
  site                 String?
  logo                 String?
  endereco             String?
  numero               String?
  complemento          String?
  bairro               String?
  cidade               String?
  estado               String?
  cep                  String?
  latitude             Float?
  longitude            Float?
  /// Dados bancários (saem no orçamento do cliente; sem banco/conta e sem PIX, o bloco não aparece)
  bancoNome            String?  @map("banco_nome")
  bancoAgencia         String?  @map("banco_agencia")
  bancoConta           String?  @map("banco_conta")
  /// Corrente / Poupança / Pagamento (texto livre)
  bancoTipoConta       String?  @map("banco_tipo_conta")
  /// Titular da conta (vazio = razão social da empresa)
  bancoTitular         String?  @map("banco_titular")
  pixChave             String?  @map("pix_chave")
  /// Timbre do orçamento: inscrições estadual/municipal (vazias = não aparecem no documento)
  inscricaoEstadual    String?  @map("inscricao_estadual")
  inscricaoMunicipal   String?  @map("inscricao_municipal")
  /// CNAE principal (subclasse, 7 dígitos). Serviço sem CNAE próprio usa este na NFS-e (lib/nfse/servico.ts)
  cnaePrincipal        String?  @map("cnae_principal") @db.VarChar(7)
  /// Responsável técnico padrão (Tecnico RESPONSAVEL_TECNICO com CREA): o orçamento novo nasce com ele
  responsavelTecnicoId String?  @map("responsavel_tecnico_id")
  plano                Plano    @default(BASICO)
  ativo                Boolean  @default(true)
  criadoEm             DateTime @default(now()) @map("criado_em")
  atualizadoEm         DateTime @updatedAt @map("atualizado_em")

  responsavelTecnico     Tecnico?                  @relation("EmpresaResponsavelTecnico", fields: [responsavelTecnicoId], references: [id], onDelete: SetNull)
  usuarios               Usuario[]
  clientes               Cliente[]
  equipamentos           Equipamento[]
  contratos              Contrato[]
  ordensServico          OrdemServico[]
  tecnicos               Tecnico[]
  unidades               Unidade[]
  tiposOs                TipoOs[]
  formularios            FormularioTemplate[]
  tiposEquipamentoCustom TipoEquipamentoCustom[]
  checklistTipoItens     ChecklistTipoItem[]
  checklistRespostas     ChecklistResposta[]
  fotosAtendimento       FotoAtendimento[]
  servicosAdicionais     ServicoAdicional[]
  fotosAdicionais        ServicoAdicionalFoto[]
  syncOperacoes          SyncOperacao[]
  servicos               Servico[]
  produtos               Produto[]
  movimentacoesEstoque   MovimentacaoEstoque[]
  notasCompra            NotaCompra[]
  deParasProduto         DeParaProdutoFornecedor[]
  orcamentos             Orcamento[]
  orcamentoAnexos        OrcamentoAnexo[]
  orcamentoEventos       OrcamentoEvento[]
  pedidoCompraEventos    PedidoCompraEvento[]
  pedidoCompraVinculos   PedidoCompraVinculo[]
  fiscal                 EmpresaFiscal?
  medicoes               Medicao[]
  contasReceber          ContaReceber[]
  prazoTemplates         PrazoTemplate[]
  pedidosCompra          PedidoCompraInterno[]
  tabelasPreco           TabelaPreco[]
  relatorios             RelatorioOs[]
  tiposProblema          TipoProblema[]
  termoTemplates         TermoReferenciaTemplate[]
  qrcodes                Qrcode[]
  cargos                 Cargo[]
  colaboradoresFolha     ColaboradorFolha[]
  modelosEncargos        ModeloEncargos[]
  folhaSnapshots         FolhaSnapshot[]
  veiculos               Veiculo[]
  equipes                Equipe[]
  checklistTemplates     ChecklistTemplate[]
  checklistsPreenchidos  ChecklistPreenchido[]
  perfisAcesso           PerfilAcesso[]
  contasPagar            ContaPagar[]
  categoriasFinanceiras  CategoriaFinanceira[]
  centrosCusto           CentroCusto[]
  fornecedores           Fornecedor[]
  emailTemplates         EmailTemplate[]
  emailLogs              EmailLog[]
  formTypeMappings       FormTypeMapping[]

  configuracao    Configuracao?
  integracaoInter IntegracaoInter?
  emailConfig     EmailConfig?

  notasFiscais NotaFiscal[]

  @@map("empresas")
}

// ─────────────────────────────────────────────
// CONFIGURAÇÕES DA EMPRESA
// ─────────────────────────────────────────────

model Configuracao {
  id        String @id @default(cuid())
  empresaId String @unique @map("empresa_id")

  // Campos obrigatórios no cadastro de clientes
  clienteEmailObrigatorio    Boolean @default(false) @map("cliente_email_obrigatorio")
  clienteWhatsappObrigatorio Boolean @default(false) @map("cliente_whatsapp_obrigatorio")
  clienteTelefoneObrigatorio Boolean @default(false) @map("cliente_telefone_obrigatorio")
  clienteCepObrigatorio      Boolean @default(false) @map("cliente_cep_obrigatorio")
  clienteRtObrigatorio       Boolean @default(false) @map("cliente_rt_obrigatorio")
  clienteArtObrigatorio      Boolean @default(false) @map("cliente_art_obrigatorio")

  // Regras de cadastro
  clienteExigirUnidade   Boolean @default(false) @map("cliente_exigir_unidade")
  clienteExigirDocumento Boolean @default(true) @map("cliente_exigir_documento")

  // Ordens de serviço
  osExigirFoto              Boolean @default(false) @map("os_exigir_foto")
  osExigirAssinatura        Boolean @default(false) @map("os_exigir_assinatura")
  osPermitirSemContrato     Boolean @default(true) @map("os_permitir_sem_contrato")
  osExigirQuestionario      Boolean @default(false) @map("os_exigir_questionario")
  osPermitirEdicaoConcluida Boolean @default(false) @map("os_permitir_edicao_concluida")

  // Notificações
  notifEmailAbrirOs       Boolean @default(false) @map("notif_email_abrir_os")
  notifEmailConcluirOs    Boolean @default(false) @map("notif_email_concluir_os")
  notifWhatsappAbrirOs    Boolean @default(false) @map("notif_whatsapp_abrir_os")
  notifWhatsappConcluirOs Boolean @default(false) @map("notif_whatsapp_concluir_os")

  // Aparência e mapa
  mostrarMapa           Boolean @default(true) @map("mostrar_mapa")
  mostrarDistancia      Boolean @default(true) @map("mostrar_distancia")
  mostrarTecnicoProximo Boolean @default(true) @map("mostrar_tecnico_proximo")

  // Portal do Cliente (white-label)
  portalCorPrimaria String? @map("portal_cor_primaria")
  portalLogo        String? @map("portal_logo") @db.Text
  portalBoasVindas  String? @map("portal_boas_vindas") @db.Text

  // QR Code (acesso público, botões de contato, restrições) — armazenado como JSON
  qrConfig Json? @map("qr_config")

  /// ISS (%) sobre serviços nos orçamentos: somado ao total; o cliente vê embutido nos preços
  issAliquota Decimal @default(0) @map("iss_aliquota") @db.Decimal(5, 2)

  /// Impressão do relatório da OS: seções ligadas/desligadas e quem vê (cliente × só interno).
  /// JSON { [secao]: { ativo, cliente } }; ausente = padrões de lib/relatorio-os/config.ts
  relatorioOsConfig Json? @map("relatorio_os_config")

  /// Padrões do orçamento novo (cada orçamento grava os seus e pode editar)
  orcamentoValidadeDias    Int      @default(10) @map("orcamento_validade_dias")
  orcamentoGarantiaServico String?  @default("90 dias") @map("orcamento_garantia_servico")
  orcamentoGarantiaPecas   String?  @default("Conforme garantia do fabricante") @map("orcamento_garantia_pecas")
  orcamentoNaoIncluso      String?  @map("orcamento_nao_incluso") @db.Text
  /// Normas atendidas que já vêm marcadas (lib/orcamentos/normas.ts); vazio = bloco desligado
  orcamentoNormas          String[] @default([]) @map("orcamento_normas")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("configuracoes")
}

// Integração bancária — Banco Inter (credenciais e certificado criptografados)
model IntegracaoInter {
  id            String        @id @default(cuid())
  empresaId     String        @unique @map("empresa_id")
  ativo         Boolean       @default(false)
  ambiente      AmbienteInter @default(SANDBOX)
  clientId      String?       @map("client_id")
  clientSecret  String?       @map("client_secret") @db.Text // criptografado
  contaCorrente String?       @map("conta_corrente")
  certificado   String?       @db.Text // PEM criptografado
  chavePrivada  String?       @map("chave_privada") @db.Text // PEM criptografado
  webhookSecret String?       @map("webhook_secret")
  pixChave      String?       @map("pix_chave")
  criadoEm      DateTime      @default(now()) @map("criado_em")
  atualizadoEm  DateTime      @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("integracoes_inter")
}

enum StatusEmailLog {
  ENVIADO
  ERRO
  ENTREGUE
}

// Configuração de e-mail transacional (Resend) por empresa
model EmailConfig {
  id            String  @id @default(cuid())
  empresaId     String  @unique @map("empresa_id")
  ativo         Boolean @default(false)
  apiKey        String? @map("api_key") @db.Text // criptografada
  remetente     String?
  nomeRemetente String? @map("nome_remetente")
  replyTo       String? @map("reply_to")

  // Notificações automáticas
  notifBoletoEmitido        Boolean @default(false) @map("notif_boleto_emitido")
  notifMedicaoGerada        Boolean @default(false) @map("notif_medicao_gerada")
  notifLembreteVencimento   Boolean @default(false) @map("notif_lembrete_vencimento")
  notifConfirmacaoPagamento Boolean @default(false) @map("notif_confirmacao_pagamento")
  notifCobrancaVencida      Boolean @default(false) @map("notif_cobranca_vencida")
  notifOsAberta             Boolean @default(false) @map("notif_os_aberta")
  notifOsConcluida          Boolean @default(false) @map("notif_os_concluida")
  notifOrcamentoEnviado     Boolean @default(false) @map("notif_orcamento_enviado")
  notifContratoAssinatura   Boolean @default(false) @map("notif_contrato_assinatura")

  // Lembretes de orçamento
  lembreteOrcNaoRespondido Boolean @default(false) @map("lembrete_orc_nao_respondido")
  lembreteOrcVencendo      Boolean @default(false) @map("lembrete_orc_vencendo")
  lembreteOrcVencido       Boolean @default(false) @map("lembrete_orc_vencido")
  lembreteOrcAprovadoSemOs Boolean @default(false) @map("lembrete_orc_aprovado_sem_os")
  pararSeVisualizado       Boolean @default(true) @map("parar_se_visualizado")

  diasLembreteVencimento        Int @default(3) @map("dias_lembrete_vencimento")
  diasLembreteOrcamento         Int @default(3) @map("dias_lembrete_orcamento")
  diasLembreteOrcamentoVencendo Int @default(3) @map("dias_lembrete_orcamento_vencendo")
  diasAposAprovacaoSemOs        Int @default(5) @map("dias_apos_aprovacao_sem_os")
  maxLembretesOrcamento         Int @default(3) @map("max_lembretes_orcamento")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("email_config")
}

model EmailTemplate {
  id           String   @id @default(cuid())
  empresaId    String   @map("empresa_id")
  tipo         String
  nome         String
  assunto      String
  corpo        String   @db.Text
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, tipo])
  @@map("email_templates")
}

model EmailLog {
  id             String         @id @default(cuid())
  empresaId      String         @map("empresa_id")
  para           String
  assunto        String
  templateId     String?        @map("template_id")
  referenciaId   String?        @map("referencia_id")
  referenciaTipo String?        @map("referencia_tipo")
  status         StatusEmailLog @default(ENVIADO)
  erro           String?        @db.Text
  enviadoEm      DateTime       @default(now()) @map("enviado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("email_logs")
}

// ─────────────────────────────────────────────
// USUARIO
// ─────────────────────────────────────────────

model Usuario {
  id           String    @id @default(cuid())
  empresaId    String    @map("empresa_id")
  nome         String
  email        String
  senha        String
  role         Role      @default(OPERADOR)
  avatar       String?
  telefone     String?
  ativo        Boolean   @default(true)
  ultimoAcesso DateTime? @map("ultimo_acesso")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  empresa                Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ordensEmitidas         OrdemServico[]            @relation("UsuarioCriador")
  ordensResponsavel      OrdemServico[]            @relation("OsResponsavel")
  osHistorico            OsHistorico[]
  interacoesCliente      InteracaoCliente[]
  orcamentosCriados      Orcamento[]               @relation("OrcamentoCriador")
  orcamentoAnexos        OrcamentoAnexo[]          @relation("OrcamentoAnexoAutor")
  orcamentoEventos       OrcamentoEvento[]         @relation("OrcamentoEventoAutor")
  pedidoCompraEventos    PedidoCompraEvento[]      @relation("PedidoCompraEventoAutor")
  pedidoCompraVinculos   PedidoCompraVinculo[]     @relation("PedidoCompraVinculoAutor")
  empresasFiscalEditadas EmpresaFiscal[]           @relation("EmpresaFiscalAutor")
  pedidosSolicitados     PedidoCompraInterno[]     @relation("PedidoSolicitante")
  pedidosComprador       PedidoCompraInterno[]     @relation("PedidoComprador")
  pushSubscriptions      PushSubscription[]
  contratoHistoricos     ContratoHistoricoStatus[]
  movimentacoesEstoque   MovimentacaoEstoque[]
  notasCompra            NotaCompra[]
  checklistRespostas     ChecklistResposta[]
  fotosAtendimento       FotoAtendimento[]
  servicosAdicionais     ServicoAdicional[]
  fotosAdicionais        ServicoAdicionalFoto[]
  syncOperacoes          SyncOperacao[]
  anexosOs               OsAnexo[]
  perfilAcessoId         String?                   @map("perfil_acesso_id")
  perfilAcesso           PerfilAcesso?             @relation(fields: [perfilAcessoId], references: [id])

  notasFiscaisEmitidas NotaFiscal[]       @relation("NotaFiscalEmissor")
  notasFiscaisEventos  NotaFiscalEvento[] @relation("NotaFiscalEventoAutor")

  @@unique([email, empresaId])
  @@index([empresaId, ativo])
  @@map("usuarios")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

// ─────────────────────────────────────────────
// TECNICO
// ─────────────────────────────────────────────

model Tecnico {
  id             String      @id @default(cuid())
  empresaId      String      @map("empresa_id")
  nome           String
  cpf            String
  email          String?
  telefone       String
  celular        String?
  whatsapp       String?
  tipo           TipoTecnico @default(TECNICO_CAMPO)
  crea           String?
  avatar         String?     @db.Text
  especialidades String[]

  // Dados pessoais
  rg             String?
  dataNascimento DateTime? @map("data_nascimento")
  endereco       String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String?
  estado         String?
  cep            String?

  // Dados profissionais
  cargoId           String?           @map("cargo_id")
  perfilAcessoId    String?           @map("perfil_acesso_id")
  tipoEquipe        TipoEquipe        @default(CAMPO) @map("tipo_equipe")
  dataAdmissao      DateTime?         @map("data_admissao")
  salario           Decimal?          @db.Decimal(12, 2)
  jornadaEntrada    String?           @map("jornada_entrada")
  jornadaSaida      String?           @map("jornada_saida")
  jornadaDias       String[]          @map("jornada_dias")
  statusColaborador StatusColaborador @default(ATIVO) @map("status_colaborador")

  latitude          Float?
  longitude         Float?
  ultimaLocalizacao DateTime? @map("ultima_localizacao")
  observacoes       String?
  /// Veículo "padrão" do colaborador (opcional) — puxado automaticamente na OS quando ele executa sozinho
  veiculoId         String?   @map("veiculo_id")
  ativo             Boolean   @default(true)
  criadoEm          DateTime  @default(now()) @map("criado_em")
  atualizadoEm      DateTime  @updatedAt @map("atualizado_em")

  empresa               Empresa                         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  veiculoPadrao         Veiculo?                        @relation("VeiculoPadraoColaborador", fields: [veiculoId], references: [id], onDelete: SetNull)
  cargo                 Cargo?                          @relation(fields: [cargoId], references: [id])
  perfilAcesso          PerfilAcesso?                   @relation(fields: [perfilAcessoId], references: [id])
  clientesResponsavel   Cliente[]
  contratosResponsavel  Contrato[]
  atividadesOs          AtividadeOs[]
  atividadesEquipe      AtividadeTecnico[]
  contratosRecorrencia  Contrato[]                      @relation("ContratoTecnicoRecorrencia")
  orcamentosResponsavel Orcamento[]                     @relation("OrcamentoResponsavelTecnico")
  empresasResponsavel   Empresa[]                       @relation("EmpresaResponsavelTecnico")
  competencias          TipoOs[]                        @relation("ColaboradorCompetencias")
  documentos            ColaboradorDocumento[]
  equipesLideradas      Equipe[]                        @relation("EquipeLider")
  equipesMembro         Equipe[]                        @relation("EquipeMembros")
  veiculosResponsavel   Veiculo[]                       @relation("VeiculoResponsavel")
  checklistsPreenchidos ChecklistPreenchido[]
  equipamentosMarcados  AtividadeEquipamento[]
  respostasEquipamento  RespostaFormularioEquipamento[]
  folha                 ColaboradorFolha?

  @@unique([cpf, empresaId])
  @@index([empresaId, ativo])
  @@index([veiculoId])
  @@map("tecnicos")
}

// ─────────────────────────────────────────────
// CLIENTE
// ─────────────────────────────────────────────

model Cliente {
  id                   String           @id @default(cuid())
  empresaId            String           @map("empresa_id")
  tipoPessoa           TipoPessoa       @default(JURIDICA) @map("tipo_pessoa")
  nome                 String
  nomeFantasia         String?          @map("nome_fantasia")
  cpfCnpj              String           @map("cpf_cnpj")
  inscricaoEstadual    String?          @map("inscricao_estadual")
  email                String?
  telefone             String?
  celular              String?
  contato              String?
  logo                 String?          @db.Text
  segmento             Segmento?
  origem               OrigemCliente?
  statusFinanceiro     StatusFinanceiro @default(ADIMPLENTE) @map("status_financeiro")
  satisfacao           Int?             @db.SmallInt
  ultimaPesquisaEm     DateTime?        @map("ultima_pesquisa_em")
  artNumero            String?          @map("art_numero")
  responsavelTecnicoId String?          @map("responsavel_tecnico_id")
  endereco             String?
  numero               String?
  complemento          String?
  bairro               String?
  cidade               String?
  estado               String?
  cep                  String?
  observacoes          String?
  ativo                Boolean          @default(true)

  // Perfil de faturamento
  tipoFaturamento     PerfilFaturamento? @map("tipo_faturamento")
  diaFaturamento      Int                @default(1) @map("dia_faturamento")
  condicaoPagamento   String?            @map("condicao_pagamento")
  exigePcAntesNf      Boolean            @default(false) @map("exige_pc_antes_nf")
  agrupaAdicionais    Boolean            @default(false) @map("agrupa_adicionais")
  boletoUnicoMensal   Boolean            @default(false) @map("boleto_unico_mensal")
  emailsFaturamento   String[]           @map("emails_faturamento")
  whatsappFaturamento String?            @map("whatsapp_faturamento")

  // Preferências de e-mail
  emailReceberBoletos      Boolean  @default(true) @map("email_receber_boletos")
  emailReceberRelatorios   Boolean  @default(true) @map("email_receber_relatorios")
  emailReceberLembretes    Boolean  @default(true) @map("email_receber_lembretes")
  emailReceberConfirmacoes Boolean  @default(true) @map("email_receber_confirmacoes")
  emailReceberOrcamentos   Boolean  @default(true) @map("email_receber_orcamentos")
  emailReceberOs           Boolean  @default(true) @map("email_receber_os")
  emailsCopia              String[] @map("emails_copia")

  tabelaPrecoId String? @map("tabela_preco_id")

  portalAtivo Boolean @default(false) @map("portal_ativo")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa                 Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  responsavelTecnico      Tecnico?                 @relation(fields: [responsavelTecnicoId], references: [id])
  unidades                Unidade[]
  contratos               Contrato[]
  ordensServico           OrdemServico[]
  anexos                  AnexoCliente[]
  contatosCliente         ContatoCliente[]
  comunicacaoPreferencias ComunicacaoPreferencia[]
  interacoes              InteracaoCliente[]
  orcamentos              Orcamento[]
  medicoes                Medicao[]
  contasReceber           ContaReceber[]
  tabelaPreco             TabelaPreco?             @relation(fields: [tabelaPrecoId], references: [id])

  notasFiscais NotaFiscal[]

  @@unique([cpfCnpj, empresaId])
  @@index([empresaId, ativo])
  @@index([empresaId, nome])
  @@index([empresaId, segmento])
  @@index([responsavelTecnicoId])
  @@index([tabelaPrecoId])
  @@map("clientes")
}

// ─────────────────────────────────────────────
// CONTATO DO CLIENTE
// ─────────────────────────────────────────────

model ContatoCliente {
  id        String      @id @default(cuid())
  empresaId String      @map("empresa_id")
  clienteId String      @map("cliente_id")
  nome      String
  cargo     String?
  tipo      TipoContato @default(OUTRO)
  telefone  String?
  whatsapp  String?
  email     String?
  principal Boolean     @default(false)
  ativo     Boolean     @default(true)

  // Acesso ao Portal do Cliente
  senha             String?
  senhaProvisoria   String?   @map("senha_provisoria") // texto legível p/ consulta do gestor
  acessoConcedidoEm DateTime? @map("acesso_concedido_em")
  ultimoAcesso      DateTime? @map("ultimo_acesso")
  permissoes        Json?

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  cliente                 Cliente                  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ordensAbertas           OrdemServico[]           @relation("OsContatoOrigem")
  orcamentosAc            Orcamento[]
  comunicacaoPreferencias ComunicacaoPreferencia[]

  @@index([clienteId])
  @@index([empresaId])
  @@map("contatos_cliente")
}

// ─────────────────────────────────────────────
// PREFERÊNCIA DE COMUNICAÇÃO (quem recebe o quê, por qual canal)
// ─────────────────────────────────────────────

model ComunicacaoPreferencia {
  id        String           @id @default(cuid())
  empresaId String           @map("empresa_id")
  clienteId String           @map("cliente_id")
  contatoId String           @map("contato_id")
  tipo      TipoComunicacao
  canal     CanalComunicacao @default(EMAIL)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  cliente Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  contato ContatoCliente @relation(fields: [contatoId], references: [id], onDelete: Cascade)

  @@unique([contatoId, tipo])
  @@index([clienteId, tipo])
  @@index([empresaId])
  @@map("comunicacao_preferencias")
}

// ─────────────────────────────────────────────
// INTERAÇÃO COM O CLIENTE (histórico)
// ─────────────────────────────────────────────

model InteracaoCliente {
  id        String        @id @default(cuid())
  empresaId String        @map("empresa_id")
  clienteId String        @map("cliente_id")
  usuarioId String        @map("usuario_id")
  tipo      TipoInteracao
  descricao String
  criadoEm  DateTime      @default(now()) @map("criado_em")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([clienteId])
  @@map("interacoes_cliente")
}

// ─────────────────────────────────────────────
// UNIDADE (filial / endereço do cliente)
// ─────────────────────────────────────────────

model Unidade {
  id           String   @id @default(cuid())
  empresaId    String   @map("empresa_id")
  clienteId    String   @map("cliente_id")
  nome         String
  principal    Boolean  @default(false)
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  cidade       String?
  estado       String?
  cep          String?
  latitude     Float?
  longitude    Float?
  telefone     String?
  observacoes  String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa       Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cliente       Cliente           @relation(fields: [clienteId], references: [id])
  equipamentos  Equipamento[]
  contratos     ContratoUnidade[]
  ordensServico OrdemServico[]
  orcamentos    Orcamento[]

  @@index([clienteId])
  @@index([empresaId])
  @@map("unidades")
}

// ─────────────────────────────────────────────
// ANEXO DO CLIENTE
// ─────────────────────────────────────────────

model AnexoCliente {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  clienteId String   @map("cliente_id")
  nome      String
  tipo      String
  tamanho   Int
  conteudo  String   @db.Text
  criadoEm  DateTime @default(now()) @map("criado_em")

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("anexos_clientes")
}

// ─────────────────────────────────────────────
// EQUIPAMENTO
// ─────────────────────────────────────────────

model Equipamento {
  id                  String          @id @default(cuid())
  empresaId           String          @map("empresa_id")
  unidadeId           String          @map("unidade_id")
  // tipo (enum) mantido em sincronia p/ telas legadas; tipoEquipamentoId é o canônico
  tipo                TipoEquipamento
  tipoEquipamentoId   String?         @map("tipo_equipamento_id")
  marca               String
  modelo              String
  numeroSerie         String?         @map("numero_serie")
  patrimonio          String?
  nome                String?
  anoFabricacao       String?         @map("ano_fabricacao")
  capacidade          String?
  fluido              String?
  tensao              String?
  potencia            String?
  fase                String?
  correnteNominal     String?         @map("corrente_nominal")
  observacoesTecnicas String?         @map("observacoes_tecnicas")
  // Local em hierarquia: Cliente -> Unidade (unidadeId) -> Setor -> Ambiente (coluna `localizacao`)
  setor               String?
  localizacao         String?
  dataInstalacao      DateTime?       @map("data_instalacao")
  dataFabricacao      DateTime?       @map("data_fabricacao")
  garantiaInicio      DateTime?       @map("garantia_inicio")
  garantiaAte         DateTime?       @map("garantia_ate")
  observacoes         String?
  fotos               String[]
  ativo               Boolean         @default(true)
  criadoEm            DateTime        @default(now()) @map("criado_em")
  atualizadoEm        DateTime        @updatedAt @map("atualizado_em")

  empresa             Empresa                         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  unidade             Unidade                         @relation(fields: [unidadeId], references: [id])
  tipoEquipamento     TipoEquipamentoCustom?          @relation(fields: [tipoEquipamentoId], references: [id])
  ordensServico       OrdemServico[]
  qrcode              Qrcode?
  atividades          AtividadeEquipamento[]
  respostasFormulario RespostaFormularioEquipamento[]
  checklistRespostas  ChecklistResposta[]
  fotosAtendimento    FotoAtendimento[]
  servicosAdicionais  ServicoAdicional[]
  anexosOs            OsAnexo[]

  @@index([empresaId, ativo])
  @@index([unidadeId])
  @@index([tipoEquipamentoId])
  @@map("equipamentos")
}

// ─────────────────────────────────────────────
// QR CODE (etiqueta pública do equipamento)
// ─────────────────────────────────────────────

model Qrcode {
  id            String   @id @default(cuid())
  empresaId     String   @map("empresa_id")
  codigo        String
  equipamentoId String?  @unique @map("equipamento_id")
  tokenPublico  String   @unique @default(uuid()) @map("token_publico")
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  equipamento Equipamento? @relation(fields: [equipamentoId], references: [id], onDelete: SetNull)

  @@unique([codigo, empresaId])
  @@map("qrcodes")
}

// ─────────────────────────────────────────────
// CONTRATO
// ─────────────────────────────────────────────

model Contrato {
  id                   String         @id @default(cuid())
  empresaId            String         @map("empresa_id")
  clienteId            String         @map("cliente_id")
  numero               String
  tipo                 TipoContrato
  status               StatusContrato @default(ATIVO)
  periodicidade        Periodicidade  @default(MENSAL)
  valorMensal          Decimal?       @map("valor_mensal") @db.Decimal(10, 2)
  valorTotal           Decimal?       @map("valor_total") @db.Decimal(10, 2)
  dataInicio           DateTime       @map("data_inicio")
  dataFim              DateTime?      @map("data_fim")
  diaVencimento        Int?           @map("dia_vencimento")
  artNumero            String?        @map("art_numero")
  responsavelTecnicoId String?        @map("responsavel_tecnico_id")
  observacoes          String?
  documento            String?

  // Faturamento / NFS-e
  diaFaturamento          Int?                 @map("dia_faturamento")
  tipoVencimento          TipoVencimento?      @map("tipo_vencimento")
  diasAposVencimento      Int?                 @map("dias_apos_vencimento")
  diaFixoMes              Int?                 @map("dia_fixo_mes")
  ajusteFinsDeSemana      TratamentoFimSemana? @map("ajuste_fins_de_semana")
  descricaoNFSe           String?              @map("descricao_nfse")
  servicosNFSeIds         String[]             @default([]) @map("servicos_nfse_ids")
  adicionarPeriodoRef     Boolean              @default(false) @map("adicionar_periodo_ref")
  periodoRefOpcao         PeriodoRefNFSe?      @map("periodo_ref_opcao")
  adicionarNumContrato    Boolean              @default(false) @map("adicionar_num_contrato")
  adicionarVencimentoNFSe Boolean              @default(false) @map("adicionar_vencimento_nfse")

  // Escopo
  descricaoServicos String?        @map("descricao_servicos")
  itensInclusos     Json?          @map("itens_inclusos")
  qtdVisitas        Int?           @map("qtd_visitas")
  periodoVisitas    PeriodoVisita? @map("periodo_visitas")

  // Responsabilidade técnica (artNumero/responsavelTecnicoId acima)
  artVencimento DateTime? @map("art_vencimento")
  exibirRTNFSe  Boolean   @default(false) @map("exibir_rt_nfse")
  exibirRTPDF   Boolean   @default(false) @map("exibir_rt_pdf")

  // Reajuste
  reajusteAtivo          Boolean         @default(false) @map("reajuste_ativo")
  reajusteIndice         IndiceReajuste? @map("reajuste_indice")
  reajustePercentual     Decimal?        @map("reajuste_percentual") @db.Decimal(6, 3)
  reajusteMesAniversario Int?            @map("reajuste_mes_aniversario")
  reajusteNotificar      Boolean         @default(false) @map("reajuste_notificar")
  reajusteNotificarDias  Int?            @map("reajuste_notificar_dias")

  // Alertas e renovação
  alertaDias                Int?    @default(30) @map("alerta_dias")
  renovacaoAutomatica       Boolean @default(false) @map("renovacao_automatica")
  renovacaoMeses            Int?    @map("renovacao_meses")
  notificarClienteRenovacao Boolean @default(false) @map("notificar_cliente_renovacao")
  notificarClienteDias      Int?    @map("notificar_cliente_dias")
  alertaEmailCliente        Boolean @default(false) @map("alerta_email_cliente")

  // Recorrência de OS
  recorrencia           Boolean              @default(false)
  frequenciaRecorrencia Periodicidade?       @map("frequencia_recorrencia")
  diaRecorrencia        Int?                 @map("dia_recorrencia")
  fimSemanaRecorrencia  TratamentoFimSemana? @map("fim_semana_recorrencia")
  tipoOsRecorrenciaId   String?              @map("tipo_os_recorrencia_id")
  tecnicoRecorrenciaId  String?              @map("tecnico_recorrencia_id")

  // Origem: proposta de contrato (orçamento) que gerou este contrato
  origemOrcamentoId String? @unique @map("origem_orcamento_id")

  // D3: adicionais na fatura do contrato (CONSOLIDADO) ou em faturas separadas (SEPARADO, padrão)
  faturamentoAdicionais FaturamentoAdicionais @default(SEPARADO) @map("faturamento_adicionais")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa            Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  origemOrcamento    Orcamento?                 @relation("OrcamentoContrato", fields: [origemOrcamentoId], references: [id])
  cliente            Cliente                    @relation(fields: [clienteId], references: [id])
  responsavelTecnico Tecnico?                   @relation(fields: [responsavelTecnicoId], references: [id])
  tipoOsRecorrencia  TipoOs?                    @relation("ContratoTipoOsRecorrencia", fields: [tipoOsRecorrenciaId], references: [id])
  tecnicoRecorrencia Tecnico?                   @relation("ContratoTecnicoRecorrencia", fields: [tecnicoRecorrenciaId], references: [id])
  unidades           ContratoUnidade[]
  ordensServico      OrdemServico[]
  medicoes           Medicao[]
  relatorios         RelatorioOs[]
  anexos             AnexoContrato[]
  reajustes          ReajusteContrato[]
  historicoStatus    ContratoHistoricoStatus[]
  recorrenciasLocais ContratoRecorrenciaLocal[]
  contasReceber      ContaReceber[]

  @@unique([numero, empresaId])
  @@index([empresaId, status])
  @@index([empresaId, dataInicio])
  @@index([empresaId, dataFim])
  @@index([clienteId])
  @@index([responsavelTecnicoId])
  @@map("contratos")
}

// Configuração de recorrência de OS por local coberto do contrato
model ContratoRecorrenciaLocal {
  id             String               @id @default(cuid())
  empresaId      String               @map("empresa_id")
  contratoId     String               @map("contrato_id")
  unidadeId      String               @map("unidade_id")
  ativa          Boolean              @default(false)
  frequencia     Periodicidade?
  tipoOsId       String?              @map("tipo_os_id")
  tecnicoId      String?              @map("tecnico_id")
  dataPrimeiraOs DateTime?            @map("data_primeira_os")
  fimSemana      TratamentoFimSemana? @map("fim_semana")
  criadoEm       DateTime             @default(now()) @map("criado_em")
  atualizadoEm   DateTime             @updatedAt @map("atualizado_em")

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, unidadeId])
  @@map("contrato_recorrencia_local")
}

// Histórico de mudanças de status do contrato
model ContratoHistoricoStatus {
  id             String         @id @default(cuid())
  empresaId      String         @map("empresa_id")
  contratoId     String         @map("contrato_id")
  statusAnterior StatusContrato @map("status_anterior")
  statusNovo     StatusContrato @map("status_novo")
  motivo         String?
  usuarioId      String         @map("usuario_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("contrato_historico_status")
}

// Documentos/anexos do contrato (PDF assinado e demais arquivos)
model AnexoContrato {
  id         String   @id @default(cuid())
  empresaId  String   @map("empresa_id")
  contratoId String   @map("contrato_id")
  nome       String
  tipo       String
  tamanho    Int
  conteudo   String   @db.Text
  categoria  String? // ASSINADO | ANEXO
  criadoEm   DateTime @default(now()) @map("criado_em")

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@map("anexos_contrato")
}

// Histórico de reajustes aplicados ao contrato
model ReajusteContrato {
  id            String   @id @default(cuid())
  empresaId     String   @map("empresa_id")
  contratoId    String   @map("contrato_id")
  data          DateTime @default(now())
  indice        String
  percentual    Decimal  @db.Decimal(6, 3)
  valorAnterior Decimal  @map("valor_anterior") @db.Decimal(10, 2)
  valorNovo     Decimal  @map("valor_novo") @db.Decimal(10, 2)
  criadoEm      DateTime @default(now()) @map("criado_em")

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@map("reajustes_contrato")
}

// tabela de junção contrato <-> unidade
model ContratoUnidade {
  id         String @id @default(cuid())
  contratoId String @map("contrato_id")
  unidadeId  String @map("unidade_id")

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  unidade  Unidade  @relation(fields: [unidadeId], references: [id])

  @@unique([contratoId, unidadeId])
  @@map("contratos_unidades")
}

// ─────────────────────────────────────────────
// TIPO DE EQUIPAMENTO (configurável)
// ─────────────────────────────────────────────

model TipoEquipamentoCustom {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  nome      String
  descricao String?
  // Chave estável p/ ancorar tipos padrão ao antigo enum TipoEquipamento
  // (mantém compatibilidade com telas legadas e a coluna Equipamento.tipo).
  chaveEnum String?  @map("chave_enum")
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa          Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  equipamentos     Equipamento[]
  formTypeMappings FormTypeMapping[]
  checklistItens   ChecklistTipoItem[]

  @@map("tipos_equipamento_custom")
}

// ─────────────────────────────────────────────
// SERVIÇO (catálogo)
// ─────────────────────────────────────────────

model Servico {
  id          String   @id @default(cuid())
  empresaId   String   @map("empresa_id")
  /// Código alfanumérico (ex.: "LIMP01"): gerado ao criar pelas 4 primeiras letras do nome + sequencial,
  /// editável; único na empresa (maiúsculas). Chave da planilha e atalho de busca.
  codigo      String?
  nome        String
  descricao   String?
  unidade     String   @default("un")
  valorPadrao Decimal? @map("valor_padrao") @db.Decimal(10, 2)

  // Campos fiscais (preenchidos pelo usuário, sem padrão). NFS-e (lib/nfse/servico.ts):
  //   codigoLc116 = servico.codigo ("NN.NN"); codigoMunicipal = servico.codigoTributacao (vazio = o LC 116);
  //   aliquotaISS = iss.aliquota (vazio = o ISS da empresa)
  codigoMunicipal     String?  @map("codigo_municipal")
  codigoLc116         String?  @map("codigo_lc116")
  aliquotaISS         Decimal? @map("aliquota_iss") @db.Decimal(5, 2)
  /// Tributação do ISS na NFS-e (escolha amigável → iss.tipoTributacao + iss.exigibilidade do PlugNotas):
  /// TRIBUTAVEL | ISENTO | IMUNE | NAO_INCIDENCIA | SUSPENSA_JUDICIAL | SUSPENSA_ADMINISTRATIVA (texto + CHECK).
  /// Vazio = TRIBUTAVEL (tributável no município, exigível)
  nfseTributacao      String?  @map("nfse_tributacao")
  /// ISS retido pelo tomador (iss.retido + responsavelRetencao = tomador)
  issRetido           Boolean  @default(false) @map("iss_retido")
  /// CNAE próprio (subclasse, 7 dígitos). Vazio = usa o CNAE principal da empresa
  cnae                String?  @db.VarChar(7)
  /// Texto base da discriminação do serviço na nota (editável na hora de emitir)
  discriminacaoPadrao String?  @map("discriminacao_padrao")
  aliquotaPIS         Decimal? @map("aliquota_pis") @db.Decimal(5, 2)
  aliquotaCOFINS      Decimal? @map("aliquota_cofins") @db.Decimal(5, 2)
  aliquotaCSLL        Decimal? @map("aliquota_csll") @db.Decimal(5, 2)
  aliquotaIR          Decimal? @map("aliquota_ir") @db.Decimal(5, 2)
  observacaoFiscal    String?  @map("observacao_fiscal")

  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  empresa        Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  orcamentoItens OrcamentoServico[]
  medicaoItens   MedicaoItem[]
  tabelaItens    TabelaPrecoItem[]

  notasFiscaisItens NotaFiscalItem[]

  @@unique([empresaId, codigo])
  @@map("servicos")
}

// ─────────────────────────────────────────────
// PRODUTO (catálogo)
// ─────────────────────────────────────────────

model Produto {
  id                String   @id @default(cuid())
  empresaId         String   @map("empresa_id")
  /// Código numérico do produto, sequencial por empresa (1, 2, 3…), gerado ao criar; único na empresa.
  /// Chave da planilha (exportar → editar → importar atualiza em vez de duplicar).
  codigo            Int?
  nome              String
  descricao         String?
  unidade           String   @default("un")
  /// Preço de venda (o "valor padrão" que orçamentos, medições e tabelas de preço já usam)
  valorPadrao       Decimal? @map("valor_padrao") @db.Decimal(10, 2)
  /// Margem alvo % SOBRE A VENDA quando o preço foi definido por margem (preço = custo ÷ (1 − margem)).
  /// Nula = preço fixo. O preço nunca muda sozinho quando o custo muda (só há aviso).
  margemVenda       Decimal? @map("margem_venda") @db.Decimal(5, 2)
  estoqueMinimo     Int?     @map("estoque_minimo")
  /// Dados fiscais (para o faturamento): vêm do XML da NF de compra quando o produto é criado ou
  /// vinculado por ela; valor já preenchido não é sobrescrito.
  ncm               String?
  cest              String?
  gtin              String?
  /// Origem da mercadoria (0 a 8, tabela da NF-e)
  origemMercadoria  String?  @map("origem_mercadoria")
  unidadeTributavel String?  @map("unidade_tributavel")
  /// Saldo em estoque — CACHE da soma das movimentações (a fonte da verdade é movimentacoes_estoque).
  /// Só muda pela lib/estoque (lançamento + saldo na mesma transação); nunca pelo cadastro.
  saldo             Decimal  @default(0) @db.Decimal(12, 3)
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now()) @map("criado_em")

  empresa        Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  orcamentoItens OrcamentoProduto[]
  medicaoItens   MedicaoItem[]
  pedidoItens    PedidoCompraItem[]
  tabelaItens    TabelaPrecoItem[]
  movimentacoes  MovimentacaoEstoque[]
  notaItens      NotaCompraItem[]
  deParas        DeParaProdutoFornecedor[]

  @@unique([empresaId, codigo])
  @@map("produtos")
}

// ─────────────────────────────────────────────
// ESTOQUE — razão de movimentações (fonte da verdade do saldo)
// ─────────────────────────────────────────────

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
  AJUSTE
  DEVOLUCAO
}

enum OrigemMovimentacaoEstoque {
  COMPRA
  OS
  AJUSTE
  INVENTARIO
}

/// Uma linha por movimento. `quantidade` é COM SINAL (+ entra, − sai): o saldo do produto é a soma.
/// AJUSTE/INVENTARIO gravam a diferença para chegar ao valor informado. Nunca é apagada nem editada.
model MovimentacaoEstoque {
  id            String                    @id @default(cuid())
  empresaId     String                    @map("empresa_id")
  produtoId     String                    @map("produto_id")
  tipo          TipoMovimentacaoEstoque
  origem        OrigemMovimentacaoEstoque
  quantidade    Decimal                   @db.Decimal(12, 3)
  /// Saldo do produto logo depois deste movimento (extrato)
  saldoApos     Decimal                   @map("saldo_apos") @db.Decimal(12, 3)
  custoUnitario Decimal?                  @map("custo_unitario") @db.Decimal(14, 4)
  /// Id do documento de origem (nota de compra, OS…) — opcional, sem FK. COMPRA: refId = NotaCompra.id
  refId         String?                   @map("ref_id")
  observacao    String?
  usuarioId     String?                   @map("usuario_id")
  /// Futuro: estoque por local (veículo/almoxarifado). Ainda não usado.
  localId       String?                   @map("local_id")
  data          DateTime                  @default(now())
  criadoEm      DateTime                  @default(now()) @map("criado_em")

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  produto Produto  @relation(fields: [produtoId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([empresaId, produtoId, data])
  @@index([empresaId, data])
  @@map("movimentacoes_estoque")
}

// ─────────────────────────────────────────────
// TIPO DE OS (configurável pela empresa)
// ─────────────────────────────────────────────

model TipoOs {
  id               String   @id @default(cuid())
  empresaId        String   @map("empresa_id")
  nome             String
  descricao        String?
  cor              String   @default("#3b82f6")
  ativo            Boolean  @default(true)
  /// Trava da conclusão: true (padrão) = a atividade deste tipo só conclui com pelo menos 1
  /// equipamento atendido e completo; false = serviço sem equipamento (visita técnica, vistoria,
  /// orçamento): conclui sem equipamento — os que forem atendidos continuam exigindo o checklist.
  exigeEquipamento Boolean  @default(true) @map("exige_equipamento")
  criadoEm         DateTime @default(now()) @map("criado_em")

  empresa                  Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  formularios              FormularioTemplate[]
  atividades               AtividadeOs[]
  formTypeMappings         FormTypeMapping[]
  contratosRecorrencia     Contrato[]           @relation("ContratoTipoOsRecorrencia")
  colaboradoresCompetentes Tecnico[]            @relation("ColaboradorCompetencias")

  @@map("tipos_os")
}

// ─────────────────────────────────────────────
// FORMULÁRIO TEMPLATE (campos dinâmicos)
// ─────────────────────────────────────────────

model FormularioTemplate {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  nome      String
  descricao String?
  tipoOsId  String?  @map("tipo_os_id")
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa              Empresa                         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipoOs               TipoOs?                         @relation(fields: [tipoOsId], references: [id])
  campos               FormularioCampo[]
  respostas            AtividadeResposta[]
  formTypeMappings     FormTypeMapping[]
  respostasEquipamento RespostaFormularioEquipamento[]

  @@map("formulario_templates")
}

enum TipoCampo {
  TEXTO_CURTO
  TEXTO_LONGO
  NUMERO
  SIM_NAO
  MULTIPLA_ESCOLHA
  DATA
  FOTO
  ASSINATURA
}

model FormularioCampo {
  id           String    @id @default(cuid())
  formularioId String    @map("formulario_id")
  label        String
  tipo         TipoCampo
  obrigatorio  Boolean   @default(false)
  ordem        Int       @default(0)
  opcoes       Json?
  /// Campo removido na edição: fica no banco (as respostas antigas apontam para ele), some do preenchimento novo
  ativo        Boolean   @default(true)

  formulario           FormularioTemplate              @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  respostas            AtividadeResposta[]
  respostasEquipamento RespostaFormularioEquipamento[]

  @@map("formulario_campos")
}

// ─────────────────────────────────────────────
// ORDEM DE SERVIÇO
// ─────────────────────────────────────────────

model OrdemServico {
  id                   String     @id @default(cuid())
  empresaId            String     @map("empresa_id")
  numero               String
  clienteId            String     @map("cliente_id")
  unidadeId            String?    @map("unidade_id")
  contratoId           String?    @map("contrato_id")
  responsavelId        String?    @map("responsavel_id")
  criadoPorId          String     @map("criado_por_id")
  prioridade           Prioridade @default(NORMAL)
  status               StatusOS   @default(ABERTA)
  /// Central da OS: false = o status segue o estado real (atividades, conclusão, medição) e é
  /// recalculado a cada mudança; true = alguém ajustou à mão (exceção) e o automático não
  /// sobrescreve até "Voltar ao automático". Quem/quando fica no histórico da OS.
  statusManual         Boolean    @default(false) @map("status_manual")
  /// Exceção da trava de equipamento: motivo informado por quem tem "concluir OS" para concluir
  /// esta OS sem equipamento atendido (quem/quando no histórico). null = trava normal.
  semEquipamentoMotivo String?    @map("sem_equipamento_motivo")
  origem               OrigemOS   @default(MANUAL)
  periodoRecorrencia   String?    @map("periodo_recorrencia")
  chamadoNumero        String?    @map("chamado_numero")
  contatoOrigemId      String?    @map("contato_origem_id")
  equipamentoId        String?    @map("equipamento_id")
  descricao            String
  previsaoConclusao    DateTime?  @map("previsao_conclusao")
  dataInicio           DateTime?  @map("data_inicio")
  dataConclusao        DateTime?  @map("data_conclusao")
  observacoes          String?
  criadoEm             DateTime   @default(now()) @map("criado_em")
  atualizadoEm         DateTime   @updatedAt @map("atualizado_em")

  empresa            Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cliente            Cliente               @relation(fields: [clienteId], references: [id])
  unidade            Unidade?              @relation(fields: [unidadeId], references: [id])
  contrato           Contrato?             @relation(fields: [contratoId], references: [id])
  responsavel        Usuario?              @relation("OsResponsavel", fields: [responsavelId], references: [id])
  criadoPor          Usuario               @relation("UsuarioCriador", fields: [criadoPorId], references: [id])
  contatoOrigem      ContatoCliente?       @relation("OsContatoOrigem", fields: [contatoOrigemId], references: [id])
  equipamento        Equipamento?          @relation(fields: [equipamentoId], references: [id])
  atividades         AtividadeOs[]
  itensOrcamento     OsItemOrcamento[]
  anexos             OsAnexo[]
  historico          OsHistorico[]
  orcamentos         OrcamentoOs[]
  medicaoItens       MedicaoItem[]
  pedidosCompra      PedidoCompraInterno[]
  prazos             OsPrazo[]
  relatorios         RelatorioOs[]
  servicosAdicionais ServicoAdicional[]

  notasFiscais NotaFiscal[]

  @@unique([numero, empresaId])
  @@index([empresaId, status])
  @@index([empresaId, criadoEm])
  @@index([empresaId, previsaoConclusao])
  @@index([empresaId, origem, status])
  @@index([clienteId])
  @@index([contratoId])
  @@index([responsavelId])
  @@index([unidadeId])
  @@index([equipamentoId])
  @@index([contatoOrigemId])
  @@map("ordens_servico")
}

// ─────────────────────────────────────────────
// ATIVIDADE DA OS (tarefas do técnico)
// ─────────────────────────────────────────────

enum StatusAtividade {
  AGENDADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model AtividadeOs {
  id             String          @id @default(cuid())
  empresaId      String          @map("empresa_id")
  ordemServicoId String          @map("ordem_servico_id")
  tipoOsId       String?         @map("tipo_os_id")
  /// Técnico RESPONSÁVEL (líder da equipe ou o 1º escolhido). Os demais ficam em `tecnicosEquipe`.
  tecnicoId      String?         @map("tecnico_id")
  /// Equipe usada para preencher os técnicos (opcional; só registro)
  equipeId       String?         @map("equipe_id")
  /// Veículo usado NESTA atividade (puxado da equipe/colaborador, editável; não altera o vínculo padrão)
  veiculoId      String?         @map("veiculo_id")
  titulo         String
  status         StatusAtividade @default(AGENDADA)
  dataAgendada   DateTime?       @map("data_agendada")
  /// Prazo próprio da atividade (DIA civil, sem hora): atrasa quando o dia de hoje em Brasília
  /// passa dele com a atividade ainda aberta (lib/os/prazos.ts).
  prazo          DateTime?       @map("prazo") @db.Date
  duracaoMin     Int?            @map("duracao_min")
  observacao     String?
  resumo         String?         @db.Text
  /// Segredo do link público do relatório desta atividade (/relatorio/atividade/<id>?t=<token>):
  /// 32 bytes aleatórios em base64url (43 caracteres). O banco gera ao criar a atividade (SQL
  /// 2026-10-20_relatorio_atividade_token); "Gerar novo link" troca e o link antigo para de abrir.
  tokenRelatorio String          @unique @default(dbgenerated("rtrim(translate(encode(sha256(convert_to((((gen_random_uuid())::text || (gen_random_uuid())::text) || (gen_random_uuid())::text), 'UTF8'::name)), 'base64'::text), '+/'::text, '-_'::text), '='::text)")) @map("token_relatorio")
  criadoEm       DateTime        @default(now()) @map("criado_em")
  atualizadoEm   DateTime        @updatedAt @map("atualizado_em")

  ordemServico         OrdemServico                    @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  tipoOs               TipoOs?                         @relation(fields: [tipoOsId], references: [id])
  tecnico              Tecnico?                        @relation(fields: [tecnicoId], references: [id])
  equipe               Equipe?                         @relation(fields: [equipeId], references: [id], onDelete: SetNull)
  veiculo              Veiculo?                        @relation(fields: [veiculoId], references: [id], onDelete: SetNull)
  tecnicosEquipe       AtividadeTecnico[]
  respostas            AtividadeResposta[]
  relatorios           RelatorioOs[]
  equipamentos         AtividadeEquipamento[]
  respostasEquipamento RespostaFormularioEquipamento[]
  checklistRespostas   ChecklistResposta[]
  fotosAtendimento     FotoAtendimento[]
  servicosAdicionais   ServicoAdicional[]
  anexosOs             OsAnexo[]

  @@index([ordemServicoId])
  @@index([tecnicoId])
  @@index([tipoOsId])
  @@index([equipeId])
  @@index([veiculoId])
  @@index([empresaId, dataAgendada])
  @@map("atividades_os")
}

/// Demais técnicos da atividade (além do responsável `AtividadeOs.tecnicoId`).
model AtividadeTecnico {
  atividadeId String   @map("atividade_id")
  tecnicoId   String   @map("tecnico_id")
  criadoEm    DateTime @default(now()) @map("criado_em")

  atividade AtividadeOs @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  tecnico   Tecnico     @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)

  @@id([atividadeId, tecnicoId])
  @@index([tecnicoId])
  @@map("atividade_tecnicos")
}

model AtividadeResposta {
  id           String  @id @default(cuid())
  atividadeId  String  @map("atividade_id")
  campoId      String  @map("campo_id")
  formularioId String  @map("formulario_id")
  resposta     String? @db.Text
  arquivoUrl   String? @db.Text

  atividade  AtividadeOs        @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  campo      FormularioCampo    @relation(fields: [campoId], references: [id])
  formulario FormularioTemplate @relation(fields: [formularioId], references: [id])

  @@unique([atividadeId, campoId])
  @@map("atividade_respostas")
}

// ─────────────────────────────────────────────
// FORMULÁRIO POR TIPO (Tipo de Equipamento + Tipo de OS → Formulário)
// Uma combinação (tipoEquipamento + tipoOs) aponta para um único formulário.
// ─────────────────────────────────────────────

model FormTypeMapping {
  id                     String   @id @default(cuid())
  empresaId              String   @map("empresa_id")
  tipoEquipamentoId      String   @map("tipo_equipamento_id")
  tipoOsId               String   @map("tipo_os_id")
  formularioTemplateId   String   @map("formulario_template_id")
  // Obrigatoriedade do formulário no fluxo do técnico (PWA)
  obrigatorioConcluir    Boolean  @default(false) @map("obrigatorio_concluir")
  obrigatorioImpedimento Boolean  @default(false) @map("obrigatorio_impedimento")
  criadoEm               DateTime @default(now()) @map("criado_em")
  atualizadoEm           DateTime @updatedAt @map("atualizado_em")

  empresa            Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipoEquipamento    TipoEquipamentoCustom @relation(fields: [tipoEquipamentoId], references: [id], onDelete: Cascade)
  tipoOs             TipoOs                @relation(fields: [tipoOsId], references: [id], onDelete: Cascade)
  formularioTemplate FormularioTemplate    @relation(fields: [formularioTemplateId], references: [id], onDelete: Cascade)

  @@unique([tipoEquipamentoId, tipoOsId])
  @@index([empresaId])
  @@map("form_type_mappings")
}

// ─────────────────────────────────────────────
// EQUIPAMENTOS DA ATIVIDADE (marcação feito/não-feito via QR)
// ─────────────────────────────────────────────

model AtividadeEquipamento {
  id            String    @id @default(cuid())
  atividadeId   String    @map("atividade_id")
  equipamentoId String    @map("equipamento_id")
  feito         Boolean   @default(false)
  feitoEm       DateTime? @map("feito_em")
  feitoPorId    String?   @map("feito_por_id")
  /// Observação do técnico sobre ESTE equipamento nesta atividade (sai no relatório e no histórico)
  observacao    String?   @db.Text
  criadoEm      DateTime  @default(now()) @map("criado_em")

  atividade   AtividadeOs @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  feitoPor    Tecnico?    @relation(fields: [feitoPorId], references: [id])

  @@unique([atividadeId, equipamentoId])
  @@index([equipamentoId])
  @@map("atividade_equipamentos")
}

/// Tipo de resposta de um item do checklist (por ora só OK / Atenção / Não se aplica).
enum TipoRespostaChecklist {
  OK_ATENCAO_NA
  /// Medição: o técnico só captura número + unidade (sem avaliar no app)
  MEDICAO
}

/// Foto do equipamento antes ou depois do serviço (as do checklist ficam sem momento)
enum MomentoFoto {
  ANTES
  DEPOIS
}

/// Serviço adicional pedido na visita: o adm decide se cobra (Etapa 3 liga à cobrança)
enum StatusCobrancaAdicional {
  A_AVALIAR
  COBRAR
  NAO_COBRAR
}

/// Resposta de um item do checklist de um equipamento atendido.
enum RespostaChecklist {
  OK
  ATENCAO
  NAO_SE_APLICA
}

/// Item do CHECKLIST do tipo de equipamento (o modelo que cada equipamento daquele tipo responde
/// numa OS). Editável no cadastro do tipo; item removido vira inativo (as respostas antigas ficam).
model ChecklistTipoItem {
  id                String                @id @default(cuid())
  empresaId         String                @map("empresa_id")
  tipoEquipamentoId String                @map("tipo_equipamento_id")
  texto             String
  tipoResposta      TipoRespostaChecklist @default(OK_ATENCAO_NA) @map("tipo_resposta")
  /// O técnico precisa anexar foto deste item (exceto quando responde "Não se aplica")
  pedirFoto         Boolean               @default(false) @map("pedir_foto")
  /// O técnico precisa escrever observação (ex.: o valor medido), exceto em "Não se aplica"
  pedirObservacao   Boolean               @default(false) @map("pedir_observacao")
  /// Medição: unidade padrão (psi, °C, A, V…)
  unidade           String?
  ordem             Int                   @default(0)
  ativo             Boolean               @default(true)
  criadoEm          DateTime              @default(now()) @map("criado_em")
  atualizadoEm      DateTime              @updatedAt @map("atualizado_em")

  empresa         Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipoEquipamento TipoEquipamentoCustom @relation(fields: [tipoEquipamentoId], references: [id], onDelete: Cascade)
  respostas       ChecklistResposta[]
  fotos           FotoAtendimento[]

  @@index([tipoEquipamentoId, ativo, ordem])
  @@index([empresaId])
  @@map("checklist_tipo_itens")
}

/// Resposta de UM item do checklist para UM equipamento atendido numa atividade. Gravada item a
/// item (nunca em lote): reabrir a execução não apaga nada.
model ChecklistResposta {
  id              String             @id @default(cuid())
  empresaId       String             @map("empresa_id")
  atividadeId     String             @map("atividade_id")
  equipamentoId   String             @map("equipamento_id")
  itemId          String             @map("item_id")
  status          RespostaChecklist?
  observacao      String?            @db.Text
  /// Texto do item quando foi respondido (o relatório antigo continua fiel se o item mudar depois)
  textoItem       String             @map("texto_item")
  /// Medição: o número capturado e a unidade (sem avaliação no app — a leitura é do adm)
  valor           Decimal?           @db.Decimal(12, 3)
  unidade         String?
  /// Observação em áudio (data URL), quando o técnico não pôde ditar nem digitar
  audioUrl        String?            @map("audio_url") @db.Text
  respondidoPorId String?            @map("respondido_por_id")
  respondidoEm    DateTime           @default(now()) @map("respondido_em")
  criadoEm        DateTime           @default(now()) @map("criado_em")
  atualizadoEm    DateTime           @updatedAt @map("atualizado_em")

  empresa       Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  atividade     AtividadeOs       @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  equipamento   Equipamento       @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  item          ChecklistTipoItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  respondidoPor Usuario?          @relation(fields: [respondidoPorId], references: [id], onDelete: SetNull)

  @@unique([atividadeId, equipamentoId, itemId])
  @@index([equipamentoId])
  @@index([itemId])
  @@map("checklist_respostas")
}

/// Foto de um equipamento atendido numa atividade — geral (itemId nulo) ou de um item do checklist.
/// Cada equipamento tem as SUAS fotos (nada é replicado entre equipamentos).
model FotoAtendimento {
  id            String       @id @default(cuid())
  empresaId     String       @map("empresa_id")
  atividadeId   String       @map("atividade_id")
  equipamentoId String       @map("equipamento_id")
  itemId        String?      @map("item_id")
  /// Imagem em data URL (base64), tipo conferido pelo conteúdo no upload
  url           String       @db.Text
  /// Antes / depois do serviço (fotos do equipamento); nulo = foto do item ou geral
  momento       MomentoFoto?
  /// Id gerado no aparelho (app offline): reenviar a mesma foto não duplica
  clientId      String?      @unique @map("client_id")
  criadoPorId   String?      @map("criado_por_id")
  criadoEm      DateTime     @default(now()) @map("criado_em")

  empresa     Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  atividade   AtividadeOs        @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  equipamento Equipamento        @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  item        ChecklistTipoItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  criadoPor   Usuario?           @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([atividadeId, equipamentoId])
  @@index([equipamentoId])
  @@index([itemId])
  @@map("fotos_atendimento")
}

/// Serviço a mais pedido pelo cliente na visita: entra na MESMA OS e no MESMO relatório, destacado
/// como "Adicional" (o adm avalia a cobrança). Criado pelo técnico, inclusive offline (clientId).
model ServicoAdicional {
  id             String                  @id @default(cuid())
  empresaId      String                  @map("empresa_id")
  ordemServicoId String                  @map("ordem_servico_id")
  atividadeId    String                  @map("atividade_id")
  equipamentoId  String?                 @map("equipamento_id")
  descricao      String                  @db.Text
  statusCobranca StatusCobrancaAdicional @default(A_AVALIAR) @map("status_cobranca")
  /// Preço definido pelo escritório ao marcar COBRAR; o adicional entra como item da medição da OS
  valor          Decimal?                @db.Decimal(12, 2)
  /// Id gerado no aparelho: reenviar não duplica
  clientId       String?                 @unique @map("client_id")
  criadoPorId    String?                 @map("criado_por_id")
  criadoEm       DateTime                @default(now()) @map("criado_em")
  atualizadoEm   DateTime                @updatedAt @map("atualizado_em")

  empresa      Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ordemServico OrdemServico           @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  atividade    AtividadeOs            @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  equipamento  Equipamento?           @relation(fields: [equipamentoId], references: [id], onDelete: SetNull)
  criadoPor    Usuario?               @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  fotos        ServicoAdicionalFoto[]

  @@index([ordemServicoId])
  @@index([atividadeId])
  @@index([equipamentoId])
  @@index([empresaId])
  @@map("servicos_adicionais")
}

model ServicoAdicionalFoto {
  id          String   @id @default(cuid())
  empresaId   String   @map("empresa_id")
  servicoId   String   @map("servico_id")
  /// Imagem em data URL (base64), tipo conferido pelo conteúdo no upload
  url         String   @db.Text
  clientId    String?  @unique @map("client_id")
  criadoPorId String?  @map("criado_por_id")
  criadoEm    DateTime @default(now()) @map("criado_em")

  empresa   Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  servico   ServicoAdicional @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  criadoPor Usuario?         @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([servicoId])
  @@index([empresaId])
  @@map("servicos_adicionais_fotos")
}

/// Operações do app do técnico já aplicadas (id gerado no aparelho): o reenvio da mesma operação
/// — sinal que cai no meio do envio — devolve o resultado guardado em vez de aplicar de novo.
model SyncOperacao {
  id           String   @id
  empresaId    String   @map("empresa_id")
  usuarioId    String   @map("usuario_id")
  tipo         String
  atividadeId  String?  @map("atividade_id")
  resultado    Json
  processadoEm DateTime @default(now()) @map("processado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([empresaId, usuarioId])
  @@index([processadoEm])
  @@map("sync_operacoes")
}

// ─────────────────────────────────────────────
// RESPOSTAS DE FORMULÁRIO POR EQUIPAMENTO
// Respostas preenchidas em massa por grupo, mas persistidas por equipamento.
// ─────────────────────────────────────────────

model RespostaFormularioEquipamento {
  id              String   @id @default(cuid())
  empresaId       String   @map("empresa_id")
  atividadeId     String   @map("atividade_id")
  equipamentoId   String   @map("equipamento_id")
  formularioId    String   @map("formulario_id")
  campoId         String   @map("campo_id")
  resposta        String?  @db.Text
  arquivoUrl      String?  @db.Text
  respondidoPorId String?  @map("respondido_por_id")
  respondidoEm    DateTime @default(now()) @map("respondido_em")

  atividade     AtividadeOs        @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  equipamento   Equipamento        @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  formulario    FormularioTemplate @relation(fields: [formularioId], references: [id])
  campo         FormularioCampo    @relation(fields: [campoId], references: [id])
  respondidoPor Tecnico?           @relation(fields: [respondidoPorId], references: [id])

  @@unique([atividadeId, equipamentoId, campoId])
  @@index([equipamentoId])
  @@map("respostas_formulario_equipamento")
}

// ─────────────────────────────────────────────
// ORÇAMENTO E FINANCEIRO DA OS
// ─────────────────────────────────────────────

model OsItemOrcamento {
  id             String    @id @default(cuid())
  ordemServicoId String    @map("ordem_servico_id")
  descricao      String
  quantidade     Decimal   @db.Decimal(10, 2)
  valorUnitario  Decimal   @map("valor_unitario") @db.Decimal(10, 2)
  valorTotal     Decimal   @map("valor_total") @db.Decimal(10, 2)
  executado      Boolean   @default(false)
  executadoEm    DateTime? @map("executado_em")

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  @@index([ordemServicoId])
  @@map("os_itens_orcamento")
}

enum StatusMedicao {
  RASCUNHO
  ENVIADA
  APROVADA
}

// ─────────────────────────────────────────────
// ANEXOS DA OS
// ─────────────────────────────────────────────

model OsAnexo {
  id             String   @id @default(cuid())
  ordemServicoId String   @map("ordem_servico_id")
  nome           String
  tipo           String
  tamanho        Int
  conteudo       String   @db.Text
  /// Foto: o equipamento da OS a que se refere (nulo = "Geral da OS"). Documento não tem.
  equipamentoId  String?  @map("equipamento_id")
  /// Atividade em que a foto foi tirada (app do técnico); nulo = enviada pelo escritório
  atividadeId    String?  @map("atividade_id")
  legenda        String?
  criadoPorId    String?  @map("criado_por_id")
  /// Id gerado no aparelho (app offline): reenviar a mesma foto não duplica
  clientId       String?  @unique @map("client_id")
  criadoEm       DateTime @default(now()) @map("criado_em")

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  equipamento  Equipamento? @relation(fields: [equipamentoId], references: [id], onDelete: SetNull)
  atividade    AtividadeOs? @relation(fields: [atividadeId], references: [id], onDelete: SetNull)
  criadoPor    Usuario?     @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([ordemServicoId])
  @@index([equipamentoId])
  @@index([atividadeId])
  @@map("os_anexos")
}

// ─────────────────────────────────────────────
// HISTÓRICO DA OS (log automático)
// ─────────────────────────────────────────────

model OsHistorico {
  id             String   @id @default(cuid())
  ordemServicoId String   @map("ordem_servico_id")
  usuarioId      String   @map("usuario_id")
  acao           String
  detalhes       String?
  criadoEm       DateTime @default(now()) @map("criado_em")

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  usuario      Usuario      @relation(fields: [usuarioId], references: [id])

  @@index([ordemServicoId])
  @@map("os_historico")
}

// ─────────────────────────────────────────────
// ORÇAMENTO (documento de proposta comercial)
// ─────────────────────────────────────────────

model Orcamento {
  id          String          @id @default(cuid())
  empresaId   String          @map("empresa_id")
  codigo      String
  nome        String
  clienteId   String          @map("cliente_id")
  criadoPorId String          @map("criado_por_id")
  tipo        TipoOrcamento   @default(COMUM)
  descricao   String?         @db.Text
  observacao  String?         @db.Text
  status      StatusOrcamento @default(RASCUNHO)
  validadeEm  DateTime?       @map("validade_em")

  // Proposta de contrato (usados quando tipo = PROPOSTA_CONTRATO)
  valorMensal          Decimal?           @map("valor_mensal") @db.Decimal(12, 2)
  frequenciaContrato   Periodicidade?     @map("frequencia_contrato")
  diaExecucao          Int?               @map("dia_execucao")
  dataInicioContrato   DateTime?          @map("data_inicio_contrato")
  vigenciaMeses        Int?               @map("vigencia_meses")
  dataFimContrato      DateTime?          @map("data_fim_contrato")
  condicaoPagamento    String?            @map("condicao_pagamento")
  diaFaturamento       Int?               @map("dia_faturamento")
  perfilFaturamento    PerfilFaturamento? @map("perfil_faturamento")
  exigePcAntesNf       Boolean            @default(false) @map("exige_pc_antes_nf")
  responsavelTecnicoId String?            @map("responsavel_tecnico_id")
  artNumero            String?            @map("art_numero")
  termoReferencia      String?            @map("termo_referencia") @db.Text
  visitasPorPeriodo    Int?               @map("visitas_por_periodo")
  equipamentosCobertos String[]           @map("equipamentos_cobertos")
  prazoEmergencial     Int?               @map("prazo_emergencial")
  prazoNormal          Int?               @map("prazo_normal")
  horarioAtendimento   String?            @map("horario_atendimento")

  totalServicos Decimal      @default(0) @map("total_servicos") @db.Decimal(12, 2)
  totalProdutos Decimal      @default(0) @map("total_produtos") @db.Decimal(12, 2)
  /// Desconto total em R$ (soma dos descontos dos grupos) — mantido para quem lê o valor antigo
  desconto      Decimal      @default(0) @db.Decimal(12, 2)
  tipoDesconto  TipoDesconto @default(VALOR) @map("tipo_desconto")
  totalGeral    Decimal      @default(0) @map("total_geral") @db.Decimal(12, 2)

  /// Desconto de cada grupo (valor em R$ ou %), aplicado no subtotal do grupo
  descontoServicos     Decimal      @default(0) @map("desconto_servicos") @db.Decimal(12, 2)
  tipoDescontoServicos TipoDesconto @default(VALOR) @map("tipo_desconto_servicos")
  descontoProdutos     Decimal      @default(0) @map("desconto_produtos") @db.Decimal(12, 2)
  tipoDescontoProdutos TipoDesconto @default(VALOR) @map("tipo_desconto_produtos")
  /// ISS sobre os serviços (líquidos do desconto): a alíquota da empresa congelada no orçamento e o valor.
  /// Somado ao total; no documento do cliente vem embutido nos preços.
  issAliquota          Decimal      @default(0) @map("iss_aliquota") @db.Decimal(5, 2)
  /// Prazo de execução dos serviços (texto curto: "5 dias úteis após aprovação"); sai no documento
  prazoExecucao        String?      @map("prazo_execucao")
  /// Forma de pagamento (à vista / parcelado / PIX / boleto…); sai no documento
  formaPagamento       String?      @map("forma_pagamento")
  /// Garantias (texto curto: "90 dias", "Conforme fabricante"); saem nas Condições do documento
  garantiaServico      String?      @map("garantia_servico")
  garantiaPecas        String?      @map("garantia_pecas")
  /// "Não incluso" (exclusões do escopo), uma por linha
  naoIncluso           String?      @map("nao_incluso") @db.Text
  /// Normas atendidas (códigos de lib/orcamentos/normas.ts); vazio = bloco não aparece
  normas               String[]     @default([])
  /// Destinatário: unidade do cliente (endereço do "Para:") e contato A/C
  unidadeId            String?      @map("unidade_id")
  contatoClienteId     String?      @map("contato_cliente_id")
  valorIss             Decimal      @default(0) @map("valor_iss") @db.Decimal(12, 2)

  tokenPublico      String    @unique @map("token_publico")
  enviadoEm         DateTime? @map("enviado_em")
  visualizadoEm     DateTime? @map("visualizado_em")
  lembreteEnviadoEm DateTime? @map("lembrete_enviado_em")
  totalLembretes    Int       @default(0) @map("total_lembretes")
  lembretesAtivos   Boolean   @default(true) @map("lembretes_ativos")
  assinadoEm        DateTime? @map("assinado_em")
  assinadoPor       String?   @map("assinado_por")
  assinadoCpf       String?   @map("assinado_cpf")
  assinaturaUrl     String?   @db.Text
  /// Aceite digital: IP e navegador de quem aprovou no link público
  aprovadoIp        String?   @map("aprovado_ip")
  aprovadoUserAgent String?   @map("aprovado_user_agent")
  /// Recusa pelo cliente no link público (status REPROVADO = "Recusado")
  recusadoEm        DateTime? @map("recusado_em")
  recusadoPor       String?   @map("recusado_por")
  recusaMotivo      String?   @map("recusa_motivo") @db.Text
  recusadoIp        String?   @map("recusado_ip")
  /// Quantas vezes o cliente abriu o link (a 1ª fica em visualizadoEm)
  visualizacoes     Int       @default(0)
  /// Resposta do cliente (aprovou/recusou) já vista pela equipe: some do sino
  respostaVistaEm   DateTime? @map("resposta_vista_em")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa            Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cliente            Cliente               @relation(fields: [clienteId], references: [id])
  criadoPor          Usuario               @relation("OrcamentoCriador", fields: [criadoPorId], references: [id])
  responsavelTecnico Tecnico?              @relation("OrcamentoResponsavelTecnico", fields: [responsavelTecnicoId], references: [id])
  unidade            Unidade?              @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  contatoCliente     ContatoCliente?       @relation(fields: [contatoClienteId], references: [id], onDelete: SetNull)
  anexos             OrcamentoAnexo[]
  eventos            OrcamentoEvento[]
  servicos           OrcamentoServico[]
  produtos           OrcamentoProduto[]
  ordensServico      OrcamentoOs[]
  medicaoItens       MedicaoItem[]
  contasReceber      ContaReceber[]
  pedidosCompra      PedidoCompraInterno[]
  contratoGerado     Contrato?             @relation("OrcamentoContrato")

  @@unique([codigo, empresaId])
  @@index([empresaId, status])
  @@index([empresaId, criadoEm])
  @@index([clienteId])
  @@map("orcamentos")
}

/// Anexos que vão junto com a proposta: arquivos enviados (datasheet, catálogo) e fotos copiadas
/// de Fotos & Anexos da OS (a proposta é um documento: a foto fica congelada nela).
model OrcamentoAnexo {
  id          String   @id @default(cuid())
  empresaId   String   @map("empresa_id")
  orcamentoId String   @map("orcamento_id")
  /// ARQUIVO (enviado) ou FOTO (imagem: sai no registro fotográfico do documento)
  tipo        String
  nome        String
  mime        String
  tamanho     Int
  conteudo    String   @db.Text
  legenda     String?
  /// De onde veio a foto (ex.: "OS-2026-0304 · Split Samsung"); nulo = enviada aqui
  origem      String?
  ordem       Int      @default(0)
  criadoPorId String?  @map("criado_por_id")
  criadoEm    DateTime @default(now()) @map("criado_em")

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  criadoPor Usuario?  @relation("OrcamentoAnexoAutor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([orcamentoId])
  @@index([empresaId])
  @@map("orcamento_anexos")
}

/// Linha do tempo do orçamento: envio (e-mail, WhatsApp, link), visualização, aprovação, recusa,
/// mudanças de status. Só acrescenta: nunca é editado.
model OrcamentoEvento {
  id          String   @id @default(cuid())
  empresaId   String   @map("empresa_id")
  orcamentoId String   @map("orcamento_id")
  /// ENVIADO_EMAIL, ENVIADO_WHATSAPP, LINK_COPIADO, ENVIADO, VISUALIZADO, APROVADO, RECUSADO, STATUS
  tipo        String
  /// Texto curto para a linha do tempo (destinatário, motivo, de → para…)
  detalhe     String?  @db.Text
  /// Quem fez (usuário do sistema); nulo = o cliente pelo link público
  usuarioId   String?  @map("usuario_id")
  ip          String?
  criadoEm    DateTime @default(now()) @map("criado_em")

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  usuario   Usuario?  @relation("OrcamentoEventoAutor", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([orcamentoId, criadoEm])
  @@index([empresaId])
  @@map("orcamento_eventos")
}

model OrcamentoServico {
  id            String  @id @default(cuid())
  orcamentoId   String  @map("orcamento_id")
  servicoId     String? @map("servico_id")
  descricao     String
  quantidade    Decimal @default(1) @db.Decimal(10, 2)
  valorUnitario Decimal @map("valor_unitario") @db.Decimal(12, 2)
  valorTotal    Decimal @map("valor_total") @db.Decimal(12, 2)
  observacao    String?
  ordem         Int     @default(0)

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  servico   Servico?  @relation(fields: [servicoId], references: [id])

  @@map("orcamento_servicos")
}

model OrcamentoProduto {
  id            String  @id @default(cuid())
  orcamentoId   String  @map("orcamento_id")
  produtoId     String? @map("produto_id")
  descricao     String
  quantidade    Decimal @default(1) @db.Decimal(10, 2)
  valorUnitario Decimal @map("valor_unitario") @db.Decimal(12, 2)
  valorTotal    Decimal @map("valor_total") @db.Decimal(12, 2)
  observacao    String?
  ordem         Int     @default(0)

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  produto   Produto?  @relation(fields: [produtoId], references: [id])

  @@map("orcamento_produtos")
}

model OrcamentoOs {
  id             String @id @default(cuid())
  orcamentoId    String @map("orcamento_id")
  ordemServicoId String @map("ordem_servico_id")

  orcamento    Orcamento    @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  @@unique([orcamentoId, ordemServicoId])
  @@map("orcamento_ordens_servico")
}

// ─────────────────────────────────────────────
// FINANCEIRO — MEDIÇÃO
// ─────────────────────────────────────────────

model Medicao {
  id         String           @id @default(cuid())
  empresaId  String           @map("empresa_id")
  clienteId  String           @map("cliente_id")
  contratoId String?          @map("contrato_id")
  numero     String
  tipo       TipoMedicao      @default(MENSAL_FIXO)
  mes        Int?
  ano        Int?
  descricao  String?
  observacao String?          @db.Text
  status     StatusMedicaoFin @default(RASCUNHO)

  valorTotal      Decimal @default(0) @map("valor_total") @db.Decimal(12, 2)
  descontoValor   Decimal @default(0) @map("desconto_valor") @db.Decimal(12, 2)
  descontoPercent Decimal @default(0) @map("desconto_percent") @db.Decimal(5, 2)
  valorLiquido    Decimal @default(0) @map("valor_liquido") @db.Decimal(12, 2)

  dataEnvio      DateTime? @map("data_envio")
  dataAprovacao  DateTime? @map("data_aprovacao")
  dataVencimento DateTime? @map("data_vencimento")
  dataPagamento  DateTime? @map("data_pagamento")

  tokenPublico String @unique @map("token_publico")

  pcNumero     String?   @map("pc_numero")
  pcAnexoUrl   String?   @map("pc_anexo_url") @db.Text
  pcRecebidoEm DateTime? @map("pc_recebido_em")

  nfNumero String? @map("nf_numero")
  nfUrl    String? @map("nf_url") @db.Text

  boletoUrl          String? @map("boleto_url") @db.Text
  boletoCodigoBarras String? @map("boleto_codigo_barras")

  formaPagamento FormaPagamento? @map("forma_pagamento")

  // Aprovação digital pública
  assinadoPor   String? @map("assinado_por")
  assinadoCpf   String? @map("assinado_cpf")
  assinaturaUrl String? @map("assinatura_url") @db.Text

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cliente       Cliente        @relation(fields: [clienteId], references: [id])
  contrato      Contrato?      @relation(fields: [contratoId], references: [id])
  itens         MedicaoItem[]
  nfs           MedicaoNf[]
  contasReceber ContaReceber[]
  relatorios    RelatorioOs[]

  notasFiscais NotaFiscal[]

  @@unique([numero, empresaId])
  @@index([empresaId, status])
  @@index([clienteId])
  @@index([contratoId])
  @@map("medicoes")
}

model MedicaoItem {
  id             String          @id @default(cuid())
  medicaoId      String          @map("medicao_id")
  tipo           TipoItemMedicao @default(SERVICO)
  servicoId      String?         @map("servico_id")
  produtoId      String?         @map("produto_id")
  ordemServicoId String?         @map("ordem_servico_id")
  orcamentoId    String?         @map("orcamento_id")
  descricao      String
  quantidade     Decimal         @default(1) @db.Decimal(10, 2)
  valorUnitario  Decimal         @map("valor_unitario") @db.Decimal(12, 2)
  valorTotal     Decimal         @map("valor_total") @db.Decimal(12, 2)

  codigoMunicipal String?  @map("codigo_municipal")
  aliquotaISS     Decimal? @map("aliquota_iss") @db.Decimal(5, 2)
  aliquotaPIS     Decimal? @map("aliquota_pis") @db.Decimal(5, 2)
  aliquotaCOFINS  Decimal? @map("aliquota_cofins") @db.Decimal(5, 2)
  aliquotaCSLL    Decimal? @map("aliquota_csll") @db.Decimal(5, 2)
  aliquotaIR      Decimal? @map("aliquota_ir") @db.Decimal(5, 2)

  observacao String?
  ordem      Int     @default(0)

  medicao      Medicao       @relation(fields: [medicaoId], references: [id], onDelete: Cascade)
  servico      Servico?      @relation(fields: [servicoId], references: [id])
  produto      Produto?      @relation(fields: [produtoId], references: [id])
  ordemServico OrdemServico? @relation(fields: [ordemServicoId], references: [id])
  orcamento    Orcamento?    @relation(fields: [orcamentoId], references: [id])

  notasFiscaisItens NotaFiscalItem[]

  @@map("medicao_itens")
}

model MedicaoNf {
  id        String   @id @default(cuid())
  medicaoId String   @map("medicao_id")
  numero    String
  url       String?  @db.Text
  emitidaEm DateTime @default(now()) @map("emitida_em")

  medicao Medicao @relation(fields: [medicaoId], references: [id], onDelete: Cascade)

  @@map("medicao_nfs")
}

// ─────────────────────────────────────────────
// FINANCEIRO — CONTAS A RECEBER
// ─────────────────────────────────────────────

model ContaReceber {
  id          String             @id @default(cuid())
  empresaId   String             @map("empresa_id")
  clienteId   String             @map("cliente_id")
  medicaoId   String?            @map("medicao_id")
  orcamentoId String?            @map("orcamento_id")
  // C6: previsão de contrato ligada ao contrato e à competência (uma por contrato/mês)
  contratoId  String?            @map("contrato_id")
  refMes      Int?               @map("ref_mes")
  refAno      Int?               @map("ref_ano")
  numero      String
  descricao   String
  valor       Decimal            @db.Decimal(12, 2)
  status      StatusContaReceber @default(PREVISTO)

  dataVencimento  DateTime?       @map("data_vencimento")
  dataRecebimento DateTime?       @map("data_recebimento")
  formaPagamento  FormaPagamento? @map("forma_pagamento")

  banco                String?
  clienteCnpj          String?       @map("cliente_cnpj")
  notificacaoEnviadaEm DateTime?     @map("notificacao_enviada_em")
  boletoUrl            String?       @map("boleto_url") @db.Text
  boletoCodigoBarras   String?       @map("boleto_codigo_barras")
  boletoId             String?       @map("boleto_id")
  boletoNossoNumero    String?       @map("boleto_nosso_numero")
  boletoPdfUrl         String?       @map("boleto_pdf_url") @db.Text
  boletoLinhaDigitavel String?       @map("boleto_linha_digitavel")
  boletoEmitidoEm      DateTime?     @map("boleto_emitido_em")
  boletoVencimento     DateTime?     @map("boleto_vencimento")
  boletoStatus         BoletoStatus? @map("boleto_status")

  // Categoria financeira: o vínculo é o ID (Leva 5.1). `categoria` (nome) fica como histórico/fallback
  // das contas antigas cujo nome não casou com nenhuma categoria cadastrada.
  categoriaId  String?  @map("categoria_id")
  categoria    String?
  observacao   String?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa             Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cliente             Cliente              @relation(fields: [clienteId], references: [id])
  medicao             Medicao?             @relation(fields: [medicaoId], references: [id])
  orcamento           Orcamento?           @relation(fields: [orcamentoId], references: [id])
  contrato            Contrato?            @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  categoriaFinanceira CategoriaFinanceira? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  notasFiscais NotaFiscal[]

  @@unique([contratoId, refAno, refMes])
  @@index([categoriaId])
  @@index([empresaId, clienteId])
  @@index([empresaId, status, dataVencimento])
  @@index([empresaId, boletoStatus, dataRecebimento])
  @@index([clienteId])
  @@index([medicaoId])
  @@index([contratoId])
  @@map("contas_receber")
}

model CategoriaFinanceira {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  nome      String
  cor       String   @default("#64748B")
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa            Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contasReceber      ContaReceber[]
  contasPagar        ContaPagar[]
  /// Fornecedores que têm esta categoria como padrão (aprendida na nota de compra)
  fornecedoresPadrao Fornecedor[]
  notasCompra        NotaCompra[]

  @@map("categorias_financeiras")
}

/// Centro de custo (E2.1): onde a despesa pesa (ex.: Obra Shopping Norte, Frota, Administrativo).
/// Cadastro padronizado (lib/cadastros); a conta a pagar aponta pelo ID, e o fornecedor guarda o
/// padrão aprendido na nota de compra.
model CentroCusto {
  id           String   @id @default(cuid())
  empresaId    String   @map("empresa_id")
  nome         String
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa            Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contasPagar        ContaPagar[]
  fornecedoresPadrao Fornecedor[]
  notasCompra        NotaCompra[]

  @@index([empresaId, ativo])
  @@map("centros_custo")
}

// Fornecedor (Leva 5.2): cadastro de verdade, ligado na conta a pagar por ID. Documento (CNPJ/CPF)
// guardado só com dígitos; único por empresa quando preenchido (NULL não conflita no PostgreSQL).
model Fornecedor {
  id                  String   @id @default(cuid())
  empresaId           String   @map("empresa_id")
  nome                String
  documento           String?
  telefone            String?
  email               String?
  observacoes         String?
  /// Padrões aprendidos na nota de compra (E2.1): a próxima nota deste fornecedor já vem com eles
  categoriaPadraoId   String?  @map("categoria_padrao_id")
  centroCustoPadraoId String?  @map("centro_custo_padrao_id")
  ativo               Boolean  @default(true)
  criadoEm            DateTime @default(now()) @map("criado_em")
  atualizadoEm        DateTime @updatedAt @map("atualizado_em")

  empresa           Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  categoriaPadrao   CategoriaFinanceira?      @relation(fields: [categoriaPadraoId], references: [id], onDelete: SetNull)
  centroCustoPadrao CentroCusto?              @relation(fields: [centroCustoPadraoId], references: [id], onDelete: SetNull)
  contasPagar       ContaPagar[]
  notasCompra       NotaCompra[]
  deParas           DeParaProdutoFornecedor[]
  pedidosCompra     PedidoCompraInterno[]

  @@unique([empresaId, documento])
  @@index([empresaId, ativo])
  @@index([categoriaPadraoId])
  @@index([centroCustoPadraoId])
  @@map("fornecedores")
}

model ContaPagar {
  id                 String           @id @default(cuid())
  empresaId          String           @map("empresa_id")
  numero             String
  // Fornecedor: o vínculo é o ID (Leva 5.2). `fornecedor`/`fornecedorCnpj` (texto) ficam como
  // histórico/fallback — e são o que aparece nas contas antigas que não casaram com um cadastro.
  fornecedorId       String?          @map("fornecedor_id")
  fornecedor         String
  fornecedorCnpj     String?          @map("fornecedor_cnpj")
  descricao          String
  valorTotal         Decimal          @map("valor_total") @db.Decimal(12, 2)
  valorPago          Decimal          @default(0) @map("valor_pago") @db.Decimal(12, 2)
  saldoRestante      Decimal          @map("saldo_restante") @db.Decimal(12, 2)
  status             StatusContaPagar @default(PENDENTE)
  dataVencimento     DateTime?        @map("data_vencimento")
  dataPagamento      DateTime?        @map("data_pagamento")
  formaPagamento     FormaPagamento?  @map("forma_pagamento")
  banco              String?
  pedidoCompraId     String?          @map("pedido_compra_id")
  /// Nota de compra (NF-e importada) que gerou esta conta — uma conta por duplicata
  notaCompraId       String?          @map("nota_compra_id")
  // Categoria financeira (Leva 5.1): conta a pagar não tinha categoria; passa a ter, por ID
  categoriaId        String?          @map("categoria_id")
  /// Centro de custo (E2.1), por ID
  centroCustoId      String?          @map("centro_custo_id")
  /// Boleto desta conta (E2.1, "DDA manual"): linha digitável (47 dígitos, boleto bancário; 48,
  /// convênio/arrecadação) e o código de barras (44) — os dois só com dígitos, DVs conferidos
  linhaDigitavel     String?          @map("linha_digitavel")
  codigoBarrasBoleto String?          @map("codigo_barras_boleto")
  observacao         String?
  criadoEm           DateTime         @default(now()) @map("criado_em")
  atualizadoEm       DateTime         @updatedAt @map("atualizado_em")

  empresa             Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pedidoCompra        PedidoCompraInterno?  @relation(fields: [pedidoCompraId], references: [id])
  categoriaFinanceira CategoriaFinanceira?  @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  centroCusto         CentroCusto?          @relation(fields: [centroCustoId], references: [id], onDelete: SetNull)
  fornecedorCadastro  Fornecedor?           @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  notaCompra          NotaCompra?           @relation(fields: [notaCompraId], references: [id], onDelete: SetNull)
  pagamentos          PagamentoContaPagar[]

  @@unique([numero, empresaId])
  @@index([categoriaId])
  @@index([centroCustoId])
  @@index([fornecedorId])
  @@index([notaCompraId])
  @@index([empresaId, status])
  @@map("contas_pagar")
}

model PagamentoContaPagar {
  id             String          @id @default(cuid())
  contaPagarId   String          @map("conta_pagar_id")
  valor          Decimal         @db.Decimal(12, 2)
  dataPagamento  DateTime        @map("data_pagamento")
  formaPagamento FormaPagamento? @map("forma_pagamento")
  banco          String?
  comprovante    String?         @db.Text
  observacao     String?
  criadoEm       DateTime        @default(now()) @map("criado_em")

  contaPagar ContaPagar @relation(fields: [contaPagarId], references: [id], onDelete: Cascade)

  @@map("pagamentos_conta_pagar")
}

// ─────────────────────────────────────────────
// PRAZOS / SLA — TEMPLATES
// ─────────────────────────────────────────────

model PrazoTemplate {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  nome      String
  descricao String?
  cor       String   @default("#0EA5E9")
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa  Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  etapas   PrazoEtapaTemplate[]
  osPrazos OsPrazo[]

  @@map("prazo_templates")
}

// Template de Termo de Referência (usado nas propostas de contrato)
model TermoReferenciaTemplate {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  nome      String
  descricao String?
  conteudo  String   @db.Text
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("termo_referencia_templates")
}

model PrazoEtapaTemplate {
  id          String           @id @default(cuid())
  templateId  String           @map("template_id")
  nome        String
  prazoHoras  Float            @default(24) @map("prazo_horas")
  responsavel ResponsavelPrazo @default(COMPRADOR)
  canal       CanalNotificacao @default(WHATSAPP)
  mensagem    String?          @db.Text
  ordem       Int              @default(0)

  template PrazoTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("prazo_etapa_templates")
}

// ─────────────────────────────────────────────
// PEDIDO DE COMPRA INTERNO
// ─────────────────────────────────────────────

model PedidoCompraInterno {
  id              String             @id @default(cuid())
  empresaId       String             @map("empresa_id")
  numero          String
  ordemServicoId  String?            @map("ordem_servico_id")
  orcamentoId     String?            @map("orcamento_id")
  solicitanteId   String             @map("solicitante_id")
  compradorId     String?            @map("comprador_id")
  status          StatusPedidoCompra @default(SOLICITADO)
  /// Quando entrou no status atual (a lista mostra "Em cotação desde 27/10")
  statusEm        DateTime           @default(now()) @map("status_em")
  prazoNecessario DateTime?          @map("prazo_necessario")
  observacao      String?            @db.Text
  /// Fornecedor a quem o PC é enviado (e-mail/WhatsApp do cadastro); opcional
  fornecedorId    String?            @map("fornecedor_id")
  /// PC avulso (sem OS/orçamento): o motivo, ex. "Reposição de estoque"
  motivo          String?
  /// Link do PDF para o fornecedor (sem login)
  tokenPublico    String             @unique @default(uuid()) @map("token_publico")
  /// Aviso ao solicitante: uma NF foi vinculada (o sino acende enquanto nfVistaEm estiver vazio)
  nfVinculadaEm   DateTime?          @map("nf_vinculada_em")
  nfVistaEm       DateTime?          @map("nf_vista_em")
  criadoEm        DateTime           @default(now()) @map("criado_em")
  atualizadoEm    DateTime           @updatedAt @map("atualizado_em")

  empresa      Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ordemServico OrdemServico?         @relation(fields: [ordemServicoId], references: [id])
  orcamento    Orcamento?            @relation(fields: [orcamentoId], references: [id])
  solicitante  Usuario               @relation("PedidoSolicitante", fields: [solicitanteId], references: [id])
  comprador    Usuario?              @relation("PedidoComprador", fields: [compradorId], references: [id])
  fornecedor   Fornecedor?           @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  itens        PedidoCompraItem[]
  contasPagar  ContaPagar[]
  notasCompra  NotaCompra[]
  eventos      PedidoCompraEvento[]
  vinculos     PedidoCompraVinculo[]

  @@unique([numero, empresaId])
  @@index([empresaId, status])
  @@index([ordemServicoId])
  @@index([fornecedorId])
  @@map("pedidos_compra_interno")
}

/// Histórico do pedido de compra: criado, editado (o que mudou), baixado/enviado ao fornecedor,
/// status, cancelado. Nunca apagado.
model PedidoCompraEvento {
  id        String   @id @default(cuid())
  empresaId String   @map("empresa_id")
  pedidoId  String   @map("pedido_id")
  /// CRIADO | EDITADO | BAIXADO | ENVIADO_EMAIL | ENVIADO_WHATSAPP | STATUS | CANCELADO
  tipo      String
  detalhe   String?  @db.Text
  usuarioId String?  @map("usuario_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pedido  PedidoCompraInterno @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuario Usuario?            @relation("PedidoCompraEventoAutor", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([pedidoId, criadoEm])
  @@index([empresaId])
  @@map("pedido_compra_eventos")
}

model PedidoCompraItem {
  id            String   @id @default(cuid())
  pedidoId      String   @map("pedido_id")
  produtoId     String?  @map("produto_id")
  descricao     String
  quantidade    Decimal  @default(1) @db.Decimal(10, 2)
  unidade       String   @default("un")
  valorEstimado Decimal? @map("valor_estimado") @db.Decimal(12, 2)
  valorReal     Decimal? @map("valor_real") @db.Decimal(12, 2)
  fornecedor    String?
  observacao    String?

  pedido   PedidoCompraInterno   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto  Produto?              @relation(fields: [produtoId], references: [id])
  vinculos PedidoCompraVinculo[]

  @@map("pedidos_compra_item")
}

/// Conciliação NF ↔ Pedido de Compra, POR ITEM: este item da NF atende esta quantidade deste item do
/// pedido (na unidade do produto: quantidade da NF × fator). Vincular 2× não duplica (único por par);
/// desvincular apaga a linha e volta o status e o valor real do item.
model PedidoCompraVinculo {
  id                String   @id @default(cuid())
  empresaId         String   @map("empresa_id")
  pedidoId          String   @map("pedido_id")
  pedidoItemId      String   @map("pedido_item_id")
  notaId            String   @map("nota_id")
  notaItemId        String   @map("nota_item_id")
  /// Quanto deste item da NF foi para o item do pedido (unidade do produto)
  quantidade        Decimal  @db.Decimal(15, 4)
  /// Custo real por unidade do produto (valor unitário da NF ÷ fator)
  valorUnitario     Decimal  @map("valor_unitario") @db.Decimal(15, 4)
  /// Valor real do item do pedido ANTES do 1º vínculo (volta a ele quando o último vínculo sai)
  valorRealAnterior Decimal? @map("valor_real_anterior") @db.Decimal(12, 2)
  /// Casou pelo produto (PRODUTO) ou pela semelhança da descrição (DESCRICAO)
  criterio          String   @default("PRODUTO")
  /// Vinculado sozinho no lançamento (idêntico) — reversível como qualquer outro
  automatico        Boolean  @default(false)
  usuarioId         String?  @map("usuario_id")
  criadoEm          DateTime @default(now()) @map("criado_em")

  empresa    Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pedido     PedidoCompraInterno @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pedidoItem PedidoCompraItem    @relation(fields: [pedidoItemId], references: [id], onDelete: Cascade)
  nota       NotaCompra          @relation(fields: [notaId], references: [id], onDelete: Cascade)
  notaItem   NotaCompraItem      @relation(fields: [notaItemId], references: [id], onDelete: Cascade)
  usuario    Usuario?            @relation("PedidoCompraVinculoAutor", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@unique([pedidoItemId, notaItemId])
  @@index([notaId])
  @@index([pedidoId])
  @@index([empresaId])
  @@map("pedido_compra_vinculos")
}

// ─────────────────────────────────────────────
// PRAZOS NA OS
// ─────────────────────────────────────────────

model OsPrazo {
  id             String        @id @default(cuid())
  ordemServicoId String        @map("ordem_servico_id")
  templateId     String?       @map("template_id")
  nome           String
  status         StatusOsPrazo @default(ATIVO)
  etapaAtual     Int           @default(0) @map("etapa_atual")
  criadoEm       DateTime      @default(now()) @map("criado_em")

  ordemServico OrdemServico   @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  template     PrazoTemplate? @relation(fields: [templateId], references: [id])
  etapas       OsPrazoEtapa[]

  @@index([ordemServicoId])
  @@index([status])
  @@map("os_prazos")
}

model OsPrazoEtapa {
  id                 String           @id @default(cuid())
  osPrazoId          String           @map("os_prazo_id")
  nome               String
  prazoHoras         Float            @default(24) @map("prazo_horas")
  prazoLimite        DateTime         @map("prazo_limite")
  status             StatusPrazoEtapa @default(PENDENTE)
  responsavel        ResponsavelPrazo @default(COMPRADOR)
