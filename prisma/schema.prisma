  @@index([usuarioId, criadoEm])
  @@map("ia_uso")
}

// ─────────────────────────────────────────────
// CUSTO DE PESSOAL (gestão de folha — NÃO é folha oficial)
// ─────────────────────────────────────────────

/// Regime de contratação do colaborador (define o modelo de encargos padrão)
enum RegimeContratacao {
  CLT
  PJ
  DIARISTA
  AUTONOMO
}

enum TipoAdicional {
  NENHUM
  INSALUBRIDADE
  PERICULOSIDADE
}

/// Dados financeiros do colaborador para a gestão de custo de pessoal (1:1 com tecnicos).
/// O salário/base mensal continua em `tecnicos.salario` (fonte única); aqui fica o resto.
/// Só quem tem a permissão "Financeiro › Custo de pessoal" lê ou grava.
model ColaboradorFolha {
  id                 String            @id @default(cuid())
  empresaId          String            @map("empresa_id")
  colaboradorId      String            @unique @map("colaborador_id")
  regime             RegimeContratacao @default(CLT)
  /// Diarista: valor da diária × dias no mês = base
  valorDiaria        Decimal?          @map("valor_diaria") @db.Decimal(12, 2)
  diasMes            Int?              @map("dias_mes")
  /// Horas pagas no mês (custo-hora = custo mensal ÷ horas). CLT 44h/semana = 220h.
  horasMes           Int               @default(220) @map("horas_mes")
  adicionalTipo      TipoAdicional     @default(NENHUM) @map("adicional_tipo")
  /// Percentual sobre o salário/base (ex.: periculosidade 30). Ignorado se houver valor fixo.
  adicionalPercent   Decimal?          @map("adicional_percent") @db.Decimal(6, 2)
  adicionalValor     Decimal?          @map("adicional_valor") @db.Decimal(12, 2)
  /// Horas extras: valor mensal estimado (manual, até integrar com o ponto)
  horasExtrasValor   Decimal?          @map("horas_extras_valor") @db.Decimal(12, 2)
  valeTransporte     Decimal?          @map("vale_transporte") @db.Decimal(12, 2)
  /// Desconta do empregado até 6% do salário/base (só CLT)
  descontaVt         Boolean           @default(true) @map("desconta_vt")
  valeAlimentacao    Decimal?          @map("vale_alimentacao") @db.Decimal(12, 2)
  planoSaude         Decimal?          @map("plano_saude") @db.Decimal(12, 2)
  outrosBeneficios   Decimal?          @map("outros_beneficios") @db.Decimal(12, 2)
  /// Outros descontos que reduzem o custo da empresa (ex.: coparticipação)
  descontos          Decimal?          @db.Decimal(12, 2)
  descontosDescricao String?           @map("descontos_descricao")
  /// Modelo de encargos específico; vazio = padrão do regime
  modeloEncargosId   String?           @map("modelo_encargos_id")
  observacoes        String?
  criadoEm           DateTime          @default(now()) @map("criado_em")
  atualizadoEm       DateTime          @updatedAt @map("atualizado_em")

  empresa        Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  colaborador    Tecnico         @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  modeloEncargos ModeloEncargos? @relation(fields: [modeloEncargosId], references: [id], onDelete: SetNull)

  @@index([empresaId])
  @@map("colaborador_folha")
}

/// Modelo de encargos por regime, com percentuais editáveis (ajustar com o contador).
/// `itens` = [{ nome, percentual }] — o total incide sobre a remuneração (base + adicionais + HE).
model ModeloEncargos {
  id           String            @id @default(cuid())
  empresaId    String            @map("empresa_id")
  nome         String
  regime       RegimeContratacao
  /// Padrão do regime (um por regime e empresa, garantido na aplicação)
  padrao       Boolean           @default(false)
  itens        Json              @default("[]")
  ativo        Boolean           @default(true)
  criadoEm     DateTime          @default(now()) @map("criado_em")
  atualizadoEm DateTime          @updatedAt @map("atualizado_em")

  empresa       Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  colaboradores ColaboradorFolha[]

  @@unique([empresaId, nome])
  @@index([empresaId, regime])
  @@map("modelos_encargos")
}

/// Foto do custo de cada colaborador num mês fechado ("YYYY-MM"). Não muda quando salário ou
/// encargos mudarem depois. Sem FK para o colaborador: o histórico fica mesmo se ele sair.
model FolhaSnapshot {
  id            String            @id @default(cuid())
  empresaId     String            @map("empresa_id")
  competencia   String
  colaboradorId String            @map("colaborador_id")
  nome          String
  funcao        String?
  equipe        String?
  regime        RegimeContratacao
  base          Decimal           @db.Decimal(12, 2)
  adicionais    Decimal           @db.Decimal(12, 2)
  encargos      Decimal           @db.Decimal(12, 2)
  beneficios    Decimal           @db.Decimal(12, 2)
  descontos     Decimal           @db.Decimal(12, 2)
  custoTotal    Decimal           @map("custo_total") @db.Decimal(12, 2)
  horasMes      Int               @map("horas_mes")
  custoHora     Decimal           @map("custo_hora") @db.Decimal(12, 2)
  /// Detalhamento (itens de encargo e percentuais usados), para auditoria
  detalhe       Json?
  criadoPor     String?           @map("criado_por")
  criadoEm      DateTime          @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, competencia, colaboradorId])
  @@index([empresaId, competencia])
  @@map("folha_snapshots")
}

// ─────────────────────────────────────────────
// ESTOQUE E2 — Nota de compra (NF-e) → produtos + estoque + contas a pagar
// ─────────────────────────────────────────────

/// IMPORTADA: XML lido, itens ainda sem produto · CONCILIADA: todo item ligado a um produto ·
/// LANCADA: entrada no estoque + contas a pagar gravadas (não muda mais)
enum StatusNotaCompra {
  IMPORTADA
  CONCILIADA
  LANCADA
}

/// NF-e de compra importada por XML (layout 4.00). Uma por chave de acesso na empresa.
model NotaCompra {
  id             String           @id @default(cuid())
  empresaId      String           @map("empresa_id")
  fornecedorId   String           @map("fornecedor_id")
  /// 44 dígitos — reimportar a mesma nota é bloqueado (único por empresa)
  chaveAcesso    String           @map("chave_acesso")
  numero         String
  serie          String
  dataEmissao    DateTime         @map("data_emissao")
  valorTotal     Decimal          @map("valor_total") @db.Decimal(12, 2)
  status         StatusNotaCompra @default(IMPORTADA)
  /// XML original, como veio
  xml            String           @db.Text
  /// Emitente como estava na nota (o cadastro do fornecedor pode mudar depois)
  emitenteNome   String           @map("emitente_nome")
  emitenteCnpj   String           @map("emitente_cnpj")
  /// Duplicatas (cobr/dup): [{ numero, vencimento: "AAAA-MM-DD", valor }]
  duplicatas     Json             @default("[]")
  /// Pedido de compra atendido por esta nota (opcional): recebe o custo real nos itens
  pedidoCompraId String?          @map("pedido_compra_id")
  /// Rascunho do lançamento financeiro (E2.1), editável até "Confirmar e lançar". Categoria e centro
  /// de custo vêm do padrão aprendido do fornecedor; a forma, do pag/tPag do XML.
  categoriaId    String?          @map("categoria_id")
  centroCustoId  String?          @map("centro_custo_id")
  formaPagamento FormaPagamento?  @map("forma_pagamento")
  /// Parcelas editadas: [{ numero, vencimento: "AAAA-MM-DD", valor, boleto }]; null = as duplicatas da NF
  parcelas       Json?
  usuarioId      String?          @map("usuario_id")
  lancadaEm      DateTime?        @map("lancada_em")
  criadoEm       DateTime         @default(now()) @map("criado_em")
  atualizadoEm   DateTime         @updatedAt @map("atualizado_em")

  empresa        Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fornecedor     Fornecedor            @relation(fields: [fornecedorId], references: [id])
  pedidoCompra   PedidoCompraInterno?  @relation(fields: [pedidoCompraId], references: [id], onDelete: SetNull)
  categoria      CategoriaFinanceira?  @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  centroCusto    CentroCusto?          @relation(fields: [centroCustoId], references: [id], onDelete: SetNull)
  usuario        Usuario?              @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  itens          NotaCompraItem[]
  contasPagar    ContaPagar[]
  vinculosPedido PedidoCompraVinculo[]

  @@unique([empresaId, chaveAcesso])
  @@index([empresaId, status, criadoEm])
  @@index([fornecedorId])
  @@index([categoriaId])
  @@index([centroCustoId])
  @@map("notas_compra")
}

/// Item da NF (det/prod). `produtoId` é preenchido na conciliação (de-para).
model NotaCompraItem {
  id                  String   @id @default(cuid())
  notaId              String   @map("nota_id")
  /// nItem da NF (1, 2, 3…)
  numeroItem          Int      @map("numero_item")
  codigoFornecedor    String   @map("codigo_fornecedor")
  descricaoFornecedor String   @map("descricao_fornecedor")
  ncm                 String?
  cfop                String?
  cest                String?
  gtin                String?
  /// Origem da mercadoria (0 a 8) do ICMS do item
  origem              String?
  unidadeTributavel   String?  @map("unidade_tributavel")
  /// Unidade comercial da nota (uCom): a quantidade e o valor unitário estão nela
  unidade             String
  quantidade          Decimal  @db.Decimal(15, 4)
  valorUnitario       Decimal  @map("valor_unitario") @db.Decimal(15, 4)
  valorTotal          Decimal  @map("valor_total") @db.Decimal(12, 2)
  /// 1 [unidade da nota] = fatorConversao [unidade do produto]. Entrada = quantidade × fator;
  /// custo por unidade do produto = valor unitário ÷ fator.
  fatorConversao      Decimal  @default(1) @map("fator_conversao") @db.Decimal(15, 6)
  /// Preço de venda definido na linha da conciliação (E2.1, rascunho): vai para o produto ao lançar.
  /// margemVenda preenchida = por margem (o preço é recalculado com o custo desta nota); só o preço =
  /// preço fixo; os dois vazios = o preço do produto não muda.
  precoVenda          Decimal? @map("preco_venda") @db.Decimal(12, 2)
  margemVenda         Decimal? @map("margem_venda") @db.Decimal(5, 2)
  produtoId           String?  @map("produto_id")
  criadoEm            DateTime @default(now()) @map("criado_em")

  nota           NotaCompra            @relation(fields: [notaId], references: [id], onDelete: Cascade)
  produto        Produto?              @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  vinculosPedido PedidoCompraVinculo[]

  @@unique([notaId, numeroItem])
  @@index([produtoId])
  @@map("notas_compra_itens")
}

/// De-para que aprende: o código do item NESTE fornecedor = este produto. Na próxima nota do
/// mesmo fornecedor, o item já vem vinculado.
model DeParaProdutoFornecedor {
  id                  String   @id @default(cuid())
  empresaId           String   @map("empresa_id")
  fornecedorId        String   @map("fornecedor_id")
  codigoFornecedor    String   @map("codigo_fornecedor")
  descricaoFornecedor String   @map("descricao_fornecedor")
  produtoId           String   @map("produto_id")
  /// Unidade em que este fornecedor vende o item (uCom) quando o fator foi aprendido
  unidadeOrigem       String?  @map("unidade_origem")
  /// 1 [unidadeOrigem] = fatorConversao [unidade do produto]; pré-preenche a próxima nota
  fatorConversao      Decimal  @default(1) @map("fator_conversao") @db.Decimal(15, 6)
  criadoEm            DateTime @default(now()) @map("criado_em")
  atualizadoEm        DateTime @updatedAt @map("atualizado_em")

  empresa    Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  produto    Produto    @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([empresaId, fornecedorId, codigoFornecedor])
  @@index([produtoId])
  @@map("de_para_produto_fornecedor")
}

/// Tentativas que contam para o limite anti força bruta: senha errada no login, pedido de "esqueci a
/// senha" e senha atual errada na troca. Sem empresa (o login acontece antes de saber a empresa).
/// A chave guarda só o HASH do e-mail / IP / usuário, nunca o texto. Linhas com mais de 1 dia são
/// apagadas no caminho (lib/acesso/limite.ts).
model TentativaAcesso {
  id       String   @id @default(cuid())
  tipo     String
  chave    String
  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([tipo, chave, criadoEm])
  @@index([criadoEm])
  @@map("tentativas_acesso")
}

/// NFS-e — a empresa como EMITENTE (gateway PlugNotas). 1:1 com a empresa (empresa da sessão).
/// O arquivo do certificado A1 e a senha NÃO ficam aqui: vão direto ao PlugNotas e são descartados;
/// guardamos só as referências (id do certificado e CNPJ do emitente lá) e o que se lê do certificado.
/// A inscrição municipal é a da própria empresa (empresas.inscricao_municipal).
model EmpresaFiscal {
  id                     String    @id @default(cuid())
  empresaId              String    @unique @map("empresa_id")
  /// SIMPLES_NACIONAL | LUCRO_PRESUMIDO | LUCRO_REAL | MEI (texto + CHECK no banco, sem enum)
  regimeTributario       String?   @map("regime_tributario")
  /// Regime especial de tributação do município (opcional)
  regimeEspecial         String?   @map("regime_especial")
  incentivoFiscal        Boolean   @default(false) @map("incentivo_fiscal")
  incentivadorCultural   Boolean   @default(false) @map("incentivador_cultural")
  /// HOMOLOGACAO (padrão) | PRODUCAO
  ambiente               String    @default("HOMOLOGACAO")
  /// Município de prestação/emissão (código IBGE de 7 dígitos)
  codigoMunicipio        String?   @map("codigo_municipio") @db.VarChar(7)
  municipioNome          String?   @map("municipio_nome")
  municipioUf            String?   @map("municipio_uf") @db.VarChar(2)
  /// Certificado A1: id no PlugNotas + o que foi lido do .pfx (titular, CNPJ, validade)
  certificadoId          String?   @map("certificado_id")
  certificadoTitular     String?   @map("certificado_titular")
  certificadoCnpj        String?   @map("certificado_cnpj") @db.VarChar(14)
  certificadoValidoAte   DateTime? @map("certificado_valido_ate")
  certificadoEnviadoEm   DateTime? @map("certificado_enviado_em")
  /// Login/senha do portal de NFS-e da prefeitura, CRIPTOGRAFADOS (AES-256-GCM, lib/crypto): nunca em texto
  prefeituraCripto       String?   @map("prefeitura_cripto")
  prefeituraAtualizadaEm DateTime? @map("prefeitura_atualizada_em")
  /// Referência do emitente no PlugNotas (o cpfCnpj) e em que ambiente foi cadastrado
  emitenteCnpj           String?   @map("emitente_cnpj") @db.VarChar(14)
  emitenteAmbiente       String?   @map("emitente_ambiente")
  emitenteSincronizadoEm DateTime? @map("emitente_sincronizado_em")
  /// NAO_CONFIGURADO | PENDENTE | ATIVO | ERRO
  status                 String    @default("NAO_CONFIGURADO")
  ultimoErro             String?   @map("ultimo_erro")
  ultimoTesteEm          DateTime? @map("ultimo_teste_em")
  ultimoTesteOk          Boolean?  @map("ultimo_teste_ok")
  ultimoTesteMensagem    String?   @map("ultimo_teste_mensagem")
  atualizadoPorId        String?   @map("atualizado_por_id")
  criadoEm               DateTime  @default(now()) @map("criado_em")
  atualizadoEm           DateTime  @updatedAt @map("atualizado_em")

  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  atualizadoPor Usuario? @relation("EmpresaFiscalAutor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@map("empresa_fiscal")
}

// ─────────────────────────────────────────────
// NFS-e — NOTAS EMITIDAS (PlugNotas). SQL: prisma/sql/2026-11-08_nfse_notas.sql
// ─────────────────────────────────────────────

/// Uma NFS-e enviada ao PlugNotas. Sai da medição (o documento de cobrança); a OS concluída emite pela
/// medição dela. Uma nota por código de serviço/regra de ISS (lib/nfse/nota.ts). Nada de token aqui.
model NotaFiscal {
  id                String    @id @default(cuid())
  empresaId         String    @map("empresa_id")
  medicaoId         String?   @map("medicao_id")
  ordemServicoId    String?   @map("ordem_servico_id")
  clienteId         String    @map("cliente_id")
  contaReceberId    String?   @map("conta_receber_id")
  /// OS | MEDICAO (de que tela partiu)
  origem            String
  /// HOMOLOGACAO | PRODUCAO (o ambiente do emitente no envio)
  ambiente          String
  /// ENVIANDO | PROCESSANDO | CONCLUIDO | REJEITADO | CANCELADO | INTERROMPIDO
  status            String    @default("ENVIANDO")
  /// Chave do agrupamento (código municipal + LC 116 + regra de ISS)
  grupo             String
  codigoLc116       String?   @map("codigo_lc116") @db.VarChar(5)
  codigoTributacao  String?   @map("codigo_tributacao")
  aliquotaIss       Decimal?  @map("aliquota_iss") @db.Decimal(5, 2)
  issRetido         Boolean   @default(false) @map("iss_retido")
  valorServicos     Decimal   @map("valor_servicos") @db.Decimal(12, 2)
  valorDesconto     Decimal   @default(0) @map("valor_desconto") @db.Decimal(12, 2)
  discriminacao     String
  tomadorCpfCnpj    String    @map("tomador_cpf_cnpj") @db.VarChar(14)
  tomadorNome       String    @map("tomador_nome")
  /// Identificação da nota no PlugNotas (o idIntegracao enviado é o nosso `id`)
  plugnotasId       String?   @unique @map("plugnotas_id")
  protocolo         String?
  numero            String?
  codigoVerificacao String?   @map("codigo_verificacao")
  autorizadaEm      DateTime? @map("autorizada_em")
  /// Endereços do PDF/XML no PlugNotas (exigem o token: a tela baixa pelo nosso servidor)
  pdfUrl            String?   @map("pdf_url")
  xmlUrl            String?   @map("xml_url")
  /// Motivo da rejeição (mensagem do PlugNotas/prefeitura, sem segredos)
  motivo            String?
  consultas         Int       @default(0)
  ultimaConsultaEm  DateTime? @map("ultima_consulta_em")
  emitidaPorId      String?   @map("emitida_por_id")
  criadoEm          DateTime  @default(now()) @map("criado_em")
  atualizadoEm      DateTime  @updatedAt @map("atualizado_em")

  empresa      Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  medicao      Medicao?           @relation(fields: [medicaoId], references: [id], onDelete: SetNull)
  ordemServico OrdemServico?      @relation(fields: [ordemServicoId], references: [id], onDelete: SetNull)
  cliente      Cliente            @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  contaReceber ContaReceber?      @relation(fields: [contaReceberId], references: [id], onDelete: SetNull)
  emitidaPor   Usuario?           @relation("NotaFiscalEmissor", fields: [emitidaPorId], references: [id], onDelete: SetNull)
  itens        NotaFiscalItem[]
  eventos      NotaFiscalEvento[]

  @@index([empresaId, status])
  @@index([medicaoId])
  @@index([ordemServicoId])
  @@index([contaReceberId])
  @@index([clienteId])
  @@map("notas_fiscais")
}

model NotaFiscalItem {
  id            String  @id @default(cuid())
  notaId        String  @map("nota_id")
  medicaoItemId String? @map("medicao_item_id")
  servicoId     String? @map("servico_id")
  descricao     String
  quantidade    Decimal @db.Decimal(10, 2)
  valorTotal    Decimal @map("valor_total") @db.Decimal(12, 2)
  valorDesconto Decimal @default(0) @map("valor_desconto") @db.Decimal(12, 2)

  nota        NotaFiscal   @relation(fields: [notaId], references: [id], onDelete: Cascade)
  medicaoItem MedicaoItem? @relation(fields: [medicaoItemId], references: [id], onDelete: SetNull)
  servico     Servico?     @relation(fields: [servicoId], references: [id], onDelete: SetNull)

  @@index([notaId])
  @@index([medicaoItemId])
  @@map("notas_fiscais_itens")
}

/// Histórico da nota: ENVIO | CONSULTA | STATUS | ERRO
model NotaFiscalEvento {
  id        String   @id @default(cuid())
  notaId    String   @map("nota_id")
  usuarioId String?  @map("usuario_id")
  tipo      String
  status    String?
  mensagem  String?
  criadoEm  DateTime @default(now()) @map("criado_em")

  nota    NotaFiscal @relation(fields: [notaId], references: [id], onDelete: Cascade)
  usuario Usuario?   @relation("NotaFiscalEventoAutor", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([notaId])
  @@map("notas_fiscais_eventos")
}
