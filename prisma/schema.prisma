}

model Veiculo {
  id                 String        @id @default(cuid())
  empresaId          String        @map("empresa_id")
  fotos              String[]
  /// Ângulo de cada foto, na mesma ordem de `fotos` (FRENTE, TRASEIRA, LATERAL_ESQUERDA, LATERAL_DIREITA, OUTRO).
  /// A capa é sempre fotos[0] = a FRENTE quando existir. Vazio em veículos antigos.
  fotosRotulos       String[]      @default([]) @map("fotos_rotulos")
  placa              String
  modelo             String
  marca              String?
  /// Ano de fabricação
  ano                String?
  anoModelo          String?       @map("ano_modelo")
  combustivel        String?
  cor                String?
  tipo               TipoVeiculo   @default(CARRO)
  chassi             String?
  renavam            String?
  quilometragemAtual Int?          @map("quilometragem_atual")
  proximaRevisaoKm   Int?          @map("proxima_revisao_km")
  proximaRevisaoData DateTime?     @map("proxima_revisao_data")
  seguroVencimento   DateTime?     @map("seguro_vencimento")
  status             StatusVeiculo @default(ATIVO)
  responsavelId      String?       @map("responsavel_id")
  equipeId           String?       @map("equipe_id")
  observacoes        String?
  criadoEm           DateTime      @default(now()) @map("criado_em")
  atualizadoEm       DateTime      @updatedAt @map("atualizado_em")

  empresa             Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  responsavel         Tecnico?              @relation("VeiculoResponsavel", fields: [responsavelId], references: [id])
  equipe              Equipe?               @relation(fields: [equipeId], references: [id])
  manutencoes         VeiculoManutencao[]
  documentos          VeiculoDocumento[]
  checklists          ChecklistPreenchido[]
  colaboradoresPadrao Tecnico[]             @relation("VeiculoPadraoColaborador")
  atividadesOs        AtividadeOs[]

  @@unique([placa, empresaId])
  @@index([empresaId, status])
  @@map("veiculos")
}

model VeiculoManutencao {
  id             String                @id @default(cuid())
  veiculoId      String                @map("veiculo_id")
